<Window x:Class="FloorballDJ.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloorballDJ – licens" Width="600" Height="500"
        MinWidth="520" MinHeight="450" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Source="/FloorballDJ;component/Assets/FloorballDJ-Logo.png" Width="82" Height="82" Stretch="Uniform" />
            <StackPanel Margin="18,7,0,0">
                <TextBlock Text="LICENS OCH PROVPERIOD" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Aktivera FloorballDJ" Style="{StaticResource SectionTitle}" FontSize="27" Margin="0,5,0,0" />
                <TextBlock Text="Licensen knyts till den här datorn och fungerar offline efter aktivering."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="{StaticResource WarningBrush}"
                         VerticalAlignment="Top" Margin="0,5,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusTitle" Text="Kontrollerar licens…" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="StatusMessage" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,22,0,0">
            <TextBlock Text="LICENSNYCKEL" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
            <TextBox x:Name="LicenseKeyBox" FontFamily="Cascadia Mono" FontSize="15" CharacterCasing="Upper"
                     ToolTip="Licensnyckeln skickas krypterat till FloorballDJ:s licenstjänst och sparas inte lokalt." />
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Första aktiveringen kräver internet. Efter en godkänd aktivering sparas ett krypterat licensbevis på datorn. Programmet avbryter aldrig pågående ljud på grund av en licenskontroll." />

        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DeactivateButton" Content="Avaktivera dator" Style="{StaticResource SecondaryButton}"
                    Visibility="Collapsed" Click="Deactivate_Click" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="RetryButton" Content="Försök igen" Style="{StaticResource SecondaryButton}"
                        MinWidth="105" Margin="0,0,8,0" Click="Retry_Click" />
                <Button x:Name="ActivateButton" Content="Aktivera licens" Style="{StaticResource PrimaryButton}"
                        MinWidth="125" Click="Activate_Click" />
                <Button x:Name="ContinueButton" Content="Fortsätt" Style="{StaticResource PrimaryButton}"
                        MinWidth="105" Margin="8,0,0,0" Visibility="Collapsed" Click="Continue_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
