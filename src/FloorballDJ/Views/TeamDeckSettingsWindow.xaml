<Window x:Class="FloorballDJ.Views.TeamDeckSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Team Deck" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TeamJingleCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#111820" />
            <Setter Property="TextElement.Foreground" Value="#111820" />
        </Style>
        <Style x:Key="TeamJingleComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#111820" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#BEEFE3" />
                    <Setter Property="Foreground" Value="#07151B" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#8CE5CF" />
                    <Setter Property="Foreground" Value="#07151B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="TEAM DECK" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Lagets måljinglar och spelarövergångar" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Sök fram spelarjinglar, välj exakt startposition och ordna spelarbrickorna direkt i lagvyn. Inställningarna sparas i profilen."
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Förhandsvisa" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Click="Preview_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="LAG I PROFILEN" Style="{StaticResource FieldLabel}" Margin="2,0,0,10" />
                    <ListBox x:Name="TeamsList" Grid.Row="1" ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}"
                             DisplayMemberPath="Name" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="+ Nytt lag" Style="{StaticResource PrimaryButton}" Click="AddTeam_Click" />
                        <Button Content="Ta bort" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RemoveTeam_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
                <Grid DataContext="{Binding SelectedTeam}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Lagnamn" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Snabbtangent" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                        CornerRadius="5" MinWidth="82" Height="36" Padding="10,0">
                                    <TextBlock Text="{Binding ShortcutDisplay}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                               FontFamily="Cascadia Mono" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <Button Content="Välj" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ChooseShortcut_Click" />
                                <Button Content="×" Style="{StaticResource SecondaryButton}" Width="38" MinWidth="38" Padding="0" Margin="6,0,0,0"
                                        ToolTip="Ta bort snabbtangent" Click="ClearShortcut_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="STANDARDJINGLE" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="Spelas direkt när lagets snabbtangent trycks." Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,18,0" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource TeamJingleCombo}" ItemContainerStyle="{StaticResource TeamJingleComboItem}"
                                      ItemsSource="{Binding DataContext.JingleChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Display" SelectedValuePath="JingleId" SelectedValue="{Binding DefaultJingleId}" />
                            <Button Grid.Column="1" Content="Sök…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    ToolTip="Sök på titel, filnamn eller deck" Click="ChooseDefaultJingle_Click" />
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" Background="#101C2D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" /><ColumnDefinition Width="16" />
                                <ColumnDefinition Width="150" /><ColumnDefinition Width="16" />
                                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ÖVERGÅNGSPUNKT" Style="{StaticResource FieldLabel}" FontSize="10" />
                                <TextBox Text="{Binding TransitionDisplay, Mode=OneWay}" Tag="Transition" TextAlignment="Center"
                                         ToolTip="Tid från standardjingelns klippta start. Skriv Auto för övergång nära jingelns slut."
                                         LostFocus="TeamTiming_LostFocus" KeyDown="TeamTiming_KeyDown" />
                                <TextBlock Text="När spelarjingeln börjar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FADE OUT LAGJINGLE" Style="{StaticResource FieldLabel}" FontSize="10" />
                                <TextBox Text="{Binding DefaultFadeOutDisplay, Mode=OneWay}" Tag="FadeOut" TextAlignment="Center"
                                         LostFocus="TeamTiming_LostFocus" KeyDown="TeamTiming_KeyDown" />
                                <TextBlock Text="Rekommenderat 1,5 s" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="FADE IN SPELARE" Style="{StaticResource FieldLabel}" FontSize="10" />
                                <TextBox Text="{Binding PlayerFadeInDisplay, Mode=OneWay}" Tag="FadeIn" TextAlignment="Center"
                                         LostFocus="TeamTiming_LostFocus" KeyDown="TeamTiming_KeyDown" />
                                <TextBlock Text="Rekommenderat 0,75 s" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="5" Margin="18,12,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Välj målskytt medan lagjingeln spelar. Den markerade spelarjingeln crossfadas automatiskt in vid övergångspunkten." />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock Text="SPELARKNAPPAR" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <Button Content="+ Lägg till spelare" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="AddPlayer_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Players}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#101C2D" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                            CornerRadius="7" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="NUMMER" Style="{StaticResource FieldLabel}" FontSize="10" />
                                                <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="SPELARE" Style="{StaticResource FieldLabel}" FontSize="10" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="ÖVERGÅNGSJINGLE" Style="{StaticResource FieldLabel}" FontSize="10" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <ComboBox Style="{StaticResource TeamJingleCombo}" ItemContainerStyle="{StaticResource TeamJingleComboItem}"
                                                              ItemsSource="{Binding DataContext.JingleChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="JingleId" SelectedValue="{Binding JingleId}"
                                                              SelectionChanged="PlayerJingle_SelectionChanged" />
                                                    <Button Grid.Column="1" Content="&#xE721;" FontFamily="Segoe Fluent Icons"
                                                            Style="{StaticResource IconButton}" Width="38" MinWidth="38" Margin="6,0,0,0"
                                                            ToolTip="Sök jingle" Click="ChoosePlayerJingle_Click" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="STARTPOSITION" Style="{StaticResource FieldLabel}" FontSize="10" />
                                                <TextBox Text="{Binding StartDisplay, Mode=OneWay}" TextAlignment="Center"
                                                         ToolTip="Absolut startposition i ljudfilen, t.ex. 1:12.500 eller 72,5 sekunder"
                                                         LostFocus="PlayerStart_LostFocus" KeyDown="PlayerStart_KeyDown" />
                                            </StackPanel>
                                            <Button Grid.Column="8" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Style="{StaticResource IconButton}"
                                                    ToolTip="Ta bort spelare" Click="RemovePlayer_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Avbryt" Style="{StaticResource SecondaryButton}" MinWidth="100" IsCancel="True" />
            <Button Content="Spara Team Deck" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="8,0,0,0"
                    IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
