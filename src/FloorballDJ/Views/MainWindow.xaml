<Window x:Class="FloorballDJ.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FloorballDJ.Converters"
        xmlns:controls="clr-namespace:FloorballDJ.Controls"
        xmlns:models="clr-namespace:FloorballDJ.Models"
        xmlns:views="clr-namespace:FloorballDJ.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FloorballDJ" Icon="/FloorballDJ;component/Assets/FloorballDJ-AppIcon.png" MinWidth="1120" MinHeight="700"
        Width="1520" Height="920" WindowStartupLocation="CenterScreen" WindowStyle="None" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:HexBrushConverter x:Key="HexBrush" />
        <conv:ButtonGradientConverter x:Key="ButtonGradient" />
        <conv:DurationConverter x:Key="Duration" />
        <conv:EmptyVisibilityConverter x:Key="EmptyVisibility" />
        <conv:DbMeterConverter x:Key="DbMeter" />
        <conv:FontFamilyValueConverter x:Key="FontFamilyValue" />
        <conv:ActiveJingleConverter x:Key="ActiveJingle" />
        <conv:TakeCountConverter x:Key="TakeCount" />
        <conv:TakeSlotsConverter x:Key="TakeSlots" />

        <Style x:Key="CompactTransportButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Width" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="JingleButton" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#30425B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AllowDrop" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#AFFFFFFF" />
                    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#50000000" BlurRadius="13" ShadowDepth="4" Opacity="0.65" /></Setter.Value></Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.84" />
                </Trigger>
                <DataTrigger Binding="{Binding HasAudio}" Value="False">
                    <Setter Property="Opacity" Value="0.64" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFE45E" />
                    <Setter Property="BorderThickness" Value="4" />
                    <Setter Property="Panel.ZIndex" Value="20" />
                    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FFE45E" BlurRadius="28" ShadowDepth="0" Opacity="1" /></Setter.Value></Setter>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ActiveJingle}">
                            <Binding Path="Id" />
                            <Binding Path="DataContext.NowPlaying.JingleId" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="3" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value></Setter>
                    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#36E0B4" BlurRadius="20" ShadowDepth="0" Opacity="0.9" /></Setter.Value></Setter>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="ActivePulse">
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.48" To="1" Duration="0:0:0.58" AutoReverse="True" RepeatBehavior="Forever" /></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ActivePulse" /></DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeckTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="16,9" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#121E30" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeckTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Left" Content="&#xE768;  AUTOPLAY" Style="{StaticResource SecondaryButton}" MinHeight="34" Height="34"
                                            Padding="14,4" Margin="5,3,8,3" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}"
                                            BorderBrush="{StaticResource AccentBrush}" Click="Autoplay_Click" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                                        <TabPanel IsItemsHost="True" Background="Transparent" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.86" To="1" Duration="0:0:0.22" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <DockPanel LastChildFill="True">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Status}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem Content="Alla ändringar autosparas" />
            <Separator />
            <StatusBarItem ToolTip="Öppna Hjälp → Licens och provperiod för information och aktivering.">
                <TextBlock x:Name="LicenseStatusText" Foreground="{StaticResource MutedBrush}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem Padding="4,0">
                <Border Width="320" Height="28" Background="{StaticResource PanelRaisedBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <TextBlock Text="⌕" FontSize="17" Foreground="{StaticResource AccentBrush}"
                                   Margin="8,-1,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="JingleSearchBox" Height="26" MinHeight="26" Padding="29,1,8,1"
                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 TextChanged="JingleSearchBox_TextChanged" PreviewKeyDown="JingleSearchBox_KeyDown"
                                 ToolTip="Sök jingle eller låt i alla deck. Enter spelar träffen, pil ned visar nästa träff och Esc stänger sökningen." />
                        <TextBlock x:Name="JingleSearchPlaceholder" Text="Sök jingle/låt  Ctrl+F"
                                   Margin="29,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="UTGÅNG  " FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="OutputDeviceText" Text="Standardenhet" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#080F1A" Offset="0" />
                    <GradientStop Color="#08111C" Offset="0.55" />
                    <GradientStop Color="#0A1421" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Integrated title bar -->
            <Grid Background="#0A1320" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Image Source="/FloorballDJ;component/Assets/FloorballDJ-Logo.png" Width="42" Height="42" Stretch="Uniform" ToolTip="FloorballDJ" />
                    <TextBlock Text="FloorballDJ" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <Menu Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="_Profil" SubmenuOpened="ProfileMenu_SubmenuOpened">
                        <MenuItem Header="Nytt projekt" Click="NewProject_Click" />
                        <MenuItem Header="Öppna…" Click="Open_Click" />
                        <MenuItem x:Name="RecentProfilesMenu" Header="Senast använda profiler">
                            <MenuItem Header="Inga profiler ännu" IsEnabled="False" />
                        </MenuItem>
                        <MenuItem Header="Spara" Click="Save_Click" InputGestureText="Ctrl+S" />
                        <MenuItem Header="Spara som…" Click="SaveAs_Click" />
                        <Separator />
                        <MenuItem Header="Importera Snap XML…" Click="ImportXml_Click" />
                        <MenuItem Header="Skapa backup" Click="Backup_Click" />
                        <Separator />
                        <MenuItem Header="Avsluta" Click="Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="_Verktyg">
                        <MenuItem Header="Inställningar…" Click="Settings_Click" />
                        <MenuItem Header="Analysera och balansera ljud…" Click="Loudness_Click" />
                        <MenuItem Header="Bygg egen jingle…" Click="MergeJingles_Click" />
                        <MenuItem Header="Kontrollera ljudfiler…" Click="FindMissing_Click" />
                    </MenuItem>
                    <MenuItem Header="_Hjälp">
                        <MenuItem Header="Kom igång och hjälp…" Click="Help_Click" InputGestureText="F1" />
                        <MenuItem Header="Sök efter uppdateringar…" Click="CheckForUpdates_Click" />
                        <MenuItem Header="Licens och provperiod…" Click="License_Click" />
                        <MenuItem Header="Autosparningshistorik…" Click="RevisionHistory_Click" />
                        <Separator />
                        <MenuItem Header="Om FloorballDJ" Click="About_Click" />
                    </MenuItem>
                </Menu>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE713;" Style="{StaticResource WindowButton}" ToolTip="Inställningar" Click="Settings_Click" />
                    <Button Content="&#xE921;" Style="{StaticResource WindowButton}" ToolTip="Minimera" Click="Minimize_Click" />
                    <Button Content="&#xE922;" Style="{StaticResource WindowButton}" ToolTip="Maximera eller återställ" Click="Maximize_Click" />
                    <Button Content="&#xE8BB;" Style="{StaticResource WindowButton}" Foreground="{StaticResource DangerBrush}" ToolTip="Stäng" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Integrated live player -->
            <Grid Grid.Row="1" Background="#D90E1929">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="*" MinWidth="210" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="10,5,12,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Source="/FloorballDJ;component/Assets/FloorballDJ-Logo.png" Width="92" Height="92"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding NowPlayingLabel}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding NowPlaying.Title}" FontFamily="Segoe UI Variable Display" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding NowPlaying.Title}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" CornerRadius="5" ClipToBounds="True" Margin="0,10">
                    <controls:WaveformControl FilePath="{Binding NowPlaying.FilePath}" PositionFraction="{Binding PositionFraction}"
                                              Cursor="Hand" MouseLeftButtonDown="PlayerWaveform_MouseLeftButtonDown"
                                              ToolTip="Klicka för att hoppa i låten" />
                </Border>

                <TextBlock Grid.Column="2" Text="{Binding RemainingText}" FontFamily="Cascadia Mono" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" />

                <controls:StereoLevelMeter Grid.Column="3" Margin="9,14" VerticalAlignment="Center"
                                           LeftDb="{Binding NowPlaying.PeakLeftDb, Mode=OneWay}"
                                           RightDb="{Binding NowPlaying.PeakRightDb, Mode=OneWay}"
                                           ToolTip="Stereo-nivå för vänster och höger kanal" />

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding ElementName=MasterVolumeSlider, Path=Value, StringFormat={}LJUDNIVÅ  {0:0.#} dB}" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="MasterVolumeText_MouseLeftButtonDown" ToolTip="Klicka för att skriva in en exakt ljudnivå" />
                    <Slider x:Name="MasterVolumeSlider" Minimum="-60" Maximum="6" Value="{Binding Settings.MasterVolumeDb, Mode=TwoWay}"
                            TickPlacement="BottomRight" TickFrequency="6" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" Height="34"
                            Foreground="#7F93AD"
                            ValueChanged="MasterVolumeSlider_ValueChanged" PreviewMouseWheel="MasterVolumeSlider_PreviewMouseWheel" ToolTip="Programvolym i dB" />
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,14,0">
                    <Button Content="&#xE71A;" Style="{StaticResource CompactTransportButton}" Background="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" Foreground="White" ToolTip="Stoppa allt" Click="Stop_Click" />
                    <Button Content="&#xE74B;" Style="{StaticResource CompactTransportButton}" ToolTip="Fade ut" Click="Fade_Click" />
                    <Button Background="{StaticResource WarningBrush}" BorderBrush="{StaticResource WarningBrush}" Foreground="#1A1308" Click="Pause_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CompactTransportButton}">
                                <Setter Property="Content" Value="&#xE769;" />
                                <Setter Property="ToolTip" Value="Pausa" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying.IsPaused}" Value="True">
                                        <Setter Property="Content" Value="&#xE768;" />
                                        <Setter Property="ToolTip" Value="Fortsätt spela" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSpaceResumePending}" Value="True">
                                        <Setter Property="Content" Value="&#xE768;" />
                                        <Setter Property="ToolTip" Value="Låten kan återupptas med Space" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Background="#142338" BorderBrush="#30425B" BorderThickness="1" CornerRadius="5" Height="42" Margin="6,0,0,0"
                            Padding="11,0" VerticalAlignment="Center" ToolTip="Antal jinglar i den aktiva kön">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="KÖ" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding QueuedCount}" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="TalkToggle" Content="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="19"
                                  Style="{StaticResource PillToggle}" Width="52" Height="42" Margin="6,0,0,0"
                                  Checked="TalkToggle_Changed" Unchecked="TalkToggle_Changed"
                                  ToolTip="PA/Talk: tona ned musiken medan speakern talar" />
                    <ToggleButton x:Name="SessionToggle" Content="●  SESSION" Style="{StaticResource PillToggle}" Height="42" Margin="6,0,0,0"
                                  IsChecked="{Binding Settings.TrackSession, Mode=OneWay}"
                                  Checked="SessionToggle_Changed" Unchecked="SessionToggle_Changed" />
                    <ToggleButton x:Name="SecondaryOutputToggle" Content="🎧  FÖRLYSSNING" Style="{StaticResource PillToggle}"
                                  Height="42" Margin="6,0,0,0" ToolTip="Växla mellan huvudutgång och utgång 2"
                                  IsChecked="{Binding UseSecondaryOutput, Mode=OneWay}"
                                  Checked="SecondaryOutputToggle_Changed" Unchecked="SecondaryOutputToggle_Changed" />
                </StackPanel>
            </Grid>

            <!-- Seamless deck workspace -->
            <TabControl x:Name="DeckTabsControl" Grid.Row="2" Style="{StaticResource DeckTabs}" SelectedItem="{Binding SelectedDeck}" ItemContainerStyle="{StaticResource DeckTab}" AllowDrop="True"
                        PreviewMouseWheel="DeckTabs_PreviewMouseWheel" PreviewMouseLeftButtonDown="DeckTabs_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="DeckTabs_PreviewMouseMove" DragOver="DeckTabs_DragOver" DragLeave="DeckTabs_DragLeave" Drop="DeckTabs_Drop"
                        PreviewMouseRightButtonDown="DeckTabs_PreviewMouseRightButtonDown">
                <TabControl.ItemsSource>
                    <MultiBinding Converter="{StaticResource TakeCount}"><Binding Path="Decks" /><Binding Path="Settings.DeckCount" /></MultiBinding>
                </TabControl.ItemsSource>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type models:Deck}">
                        <Grid Margin="8,7,8,8">
                            <ItemsControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <ItemsControl.ItemsSource>
                                    <MultiBinding Converter="{StaticResource TakeSlots}">
                                        <Binding Path="Jingles" />
                                        <Binding Path="Rows" />
                                        <Binding Path="Columns" />
                                    </MultiBinding>
                                </ItemsControl.ItemsSource>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="{Binding DataContext.Rows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Jingle}">
                                        <Button Style="{StaticResource JingleButton}" Click="Jingle_Click"
                                                PreviewMouseLeftButtonDown="Jingle_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Jingle_PreviewMouseMove"
                                                DragOver="Jingle_DragOver" DragLeave="Jingle_DragLeave" Drop="Jingle_Drop"
                                                Background="{Binding ButtonColor, Converter={StaticResource ButtonGradient}}"
                                                Foreground="{Binding TextColor, Converter={StaticResource HexBrush}}"
                                                FontFamily="{Binding DataContext.Settings.FontFamily, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontFamilyValue}}"
                                                FontSize="{Binding DataContext.Settings.TitleFontSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Egenskaper…" Click="JingleProperties_Click" />
                                                    <MenuItem Header="Ladda ljud…" Click="LoadAudio_Click" />
                                                    <MenuItem Header="Utseende">
                                                        <MenuItem Header="Ändra knappens färger…" Click="ButtonAppearance_Click" />
                                                        <MenuItem Header="Använd färger på hela raden…" Click="RowAppearance_Click" />
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Kopiera jingle" Click="CopyJingle_Click" />
                                                    <MenuItem Header="Klistra in jingle" Click="PasteJingle_Click" />
                                                    <Separator />
                                                    <MenuItem Header="Spelläge" SubmenuOpened="PlayModeMenu_SubmenuOpened">
                                                        <MenuItem Header="Solo" Tag="Solo" IsCheckable="True" Click="PlayMode_Click" />
                                                        <MenuItem Header="Mix" Tag="Mix" IsCheckable="True" Click="PlayMode_Click" />
                                                        <MenuItem Header="Duck" Tag="Duck" IsCheckable="True" Click="PlayMode_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Tillåt flera samtidiga klick" Tag="MultipleClicks" IsCheckable="True" Click="MultipleClicks_Click"
                                                                  ToolTip="Varje klick startar en ny instans från början medan tidigare instanser fortsätter. Högst 8 instanser per jingle spelar samtidigt för stabilt ljud." />
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Ta bort jingle" Foreground="{StaticResource DangerBrush}" Click="ClearJingle_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Border Width="30" Height="30" CornerRadius="15" Background="#22FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding HasAudio, Converter={StaticResource EmptyVisibility}}">
                                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Light" />
                                                </Border>
                                                <Grid Margin="8,7,8,5">
                                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                               FontWeight="SemiBold" LineHeight="20" MaxHeight="40" Margin="7,4,7,6" />
                                                    <Border Grid.Row="1" Background="#E636E0B4" BorderBrush="#70FFFFFF" BorderThickness="1" CornerRadius="7"
                                                            Padding="7,2" HorizontalAlignment="Left" Margin="0,0,48,0">
                                                        <TextBlock Text="{Binding Shortcut}" Foreground="#07140F" FontFamily="Cascadia Mono" FontSize="10" FontWeight="Bold" />
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Shortcut}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Shortcut}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Grid>
                                                <Border Background="#28000000" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding DurationSeconds, Converter={StaticResource Duration}}" FontFamily="Cascadia Mono" FontSize="9" />
                                                </Border>
                                                <Border Background="#DDFF6475" CornerRadius="6" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                    <TextBlock Text="SAKNAS" Foreground="White" FontSize="8" FontWeight="Bold" />
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                </Border>
                                                <Border Width="21" Height="21" CornerRadius="11" Background="#39F2A9" BorderBrush="White" BorderThickness="3"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Spelad under sessionen">
                                                    <Border.Effect><DropShadowEffect Color="#42E5A8" BlurRadius="8" ShadowDepth="0" Opacity="0.75" /></Border.Effect>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SessionPlayCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border Background="#E0425AE5" BorderBrush="#AFC4FF" BorderThickness="1" CornerRadius="8" Padding="6,2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Plats i uppspelningskön">
                                                    <TextBlock Text="{Binding QueuePosition, StringFormat=⏱ {0}}" Foreground="White" FontSize="9" FontWeight="Bold" />
                                                    <Border.Style>
                                                        <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding QueuePosition}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border x:Name="DropCue" Panel.ZIndex="30" Visibility="Collapsed" IsHitTestVisible="False" Background="#D90A1725"
                                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" CornerRadius="8" Margin="-4">
                                                    <Border.Effect><DropShadowEffect Color="#36E0B4" BlurRadius="20" ShadowDepth="0" Opacity="0.85" /></Border.Effect>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="↔" Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI Symbol"
                                                                   FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="DropCueText" Text="BYT PLATS" Foreground="White" FontFamily="Segoe UI Variable Text"
                                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            <views:AutoplayView x:Name="EmbeddedAutoplay" Grid.Row="2" Margin="0,40,0,0" Panel.ZIndex="10" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
