<Window x:Class="FloorballDJ.Views.RevisionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autosparningshistorik" Width="760" Height="560" MinWidth="620" MinHeight="430"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="AUTOSPARADE REVISIONER" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="Gå tillbaka till en tidigare version" Style="{StaticResource SectionTitle}" FontSize="26" Margin="0,3,0,2" />
            <TextBlock Text="Varje ändring sparas som en återställningspunkt. Den nuvarande versionen bevaras när du återställer."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="#102038" CornerRadius="7" Padding="12,9" Margin="0,16,0,10">
            <TextBlock x:Name="StatusText" Text="Läser in historiken…" Foreground="{StaticResource MutedBrush}" />
        </Border>
        <ListView x:Name="RevisionList" Grid.Row="2" SelectionMode="Single" MouseDoubleClick="RevisionList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="TIDPUNKT" Width="180" DisplayMemberBinding="{Binding TimestampText}" />
                    <GridViewColumn Header="PROFIL" Width="260" DisplayMemberBinding="{Binding ProjectName}" />
                    <GridViewColumn Header="INNEHÅLL" Width="175" DisplayMemberBinding="{Binding Summary}" />
                    <GridViewColumn Header="STORLEK" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="De 100 senaste ändrade versionerna sparas." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Stäng" Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Återställ vald" Style="{StaticResource PrimaryButton}" MinWidth="125" Click="Restore_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
