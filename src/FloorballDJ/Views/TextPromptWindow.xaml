<Window x:Class="FloorballDJ.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ange namn" Width="430" Height="220" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Text="Ange namn" Style="{StaticResource SectionTitle}" FontSize="23" />
        <TextBlock x:Name="DescriptionText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14" />
        <TextBox x:Name="ValueBox" Grid.Row="2" VerticalAlignment="Top" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Avbryt" Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Spara" Style="{StaticResource PrimaryButton}" MinWidth="96" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
