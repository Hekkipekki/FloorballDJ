<UserControl x:Class="FloorballDJ.Views.AutoplayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppBackgroundBrush}" IsHitTestVisible="True">
    <UserControl.Resources>
        <Style x:Key="FilterTab" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,7" /><Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QueueItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="QueueSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="7" Padding="5,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="QueueSurface" Property="Background" Value="#16283A" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="QueueSurface" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter TargetName="QueueSurface" Property="BorderBrush" Value="#6636E0B4" /><Setter TargetName="QueueSurface" Property="BorderThickness" Value="1" /></Trigger>
                            <Trigger Property="Tag" Value="DropBefore"><Setter TargetName="QueueSurface" Property="Background" Value="#2636E0B4" /><Setter TargetName="QueueSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="QueueSurface" Property="BorderThickness" Value="0,4,0,0" /></Trigger>
                            <Trigger Property="Tag" Value="DropAfter"><Setter TargetName="QueueSurface" Property="Background" Value="#2636E0B4" /><Setter TargetName="QueueSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="QueueSurface" Property="BorderThickness" Value="0,0,0,4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="14,12" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AUTOPLAY OCH SPELLISTOR" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Kön ligger kvar. Space tonar ut och återupptar samma låt; nästa låt startar automatiskt vid slutet." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ToggleButton x:Name="PreviewToggle" Content="🎧 FÖRLYSSNING" Style="{StaticResource PillToggle}" Margin="0,0,7,0"
                              IsChecked="{Binding UseSecondaryOutput, Mode=OneWay}" Checked="PreviewToggle_Changed" Unchecked="PreviewToggle_Changed" />
                <Button Content="Välj musikmapp" Style="{StaticResource SecondaryButton}" Click="ChooseMusicFolder_Click" />
                <Button Content="Ladda spellista" Style="{StaticResource SecondaryButton}" Margin="7,0" Click="LoadPlaylist_Click" />
                <Button Content="Spara spellista" Style="{StaticResource PrimaryButton}" Click="SavePlaylist_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="58" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="KÖAD SPELORDNING" Style="{StaticResource EyebrowText}" Margin="2,0,0,8" />
                    <ListBox x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding PlaybackQueue}" SelectedItem="{Binding ActiveQueueItem, Mode=OneWay}"
                             SelectionChanged="QueueList_SelectionChanged" KeyDown="QueueList_KeyDown" MouseDoubleClick="QueueList_MouseDoubleClick" ItemContainerStyle="{StaticResource QueueItem}"
                             AllowDrop="True" PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown" PreviewMouseMove="QueueList_PreviewMouseMove"
                             DragOver="QueueList_DragOver" DragLeave="QueueList_DragLeave" Drop="QueueList_Drop">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="14" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="{Binding AutoplayQueuePosition}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,9,0,0">
                        <Button Content="Spela nu" Style="{StaticResource PrimaryButton}" Click="PlaySelected_Click" />
                        <Button Content="Ta bort" Style="{StaticResource SecondaryButton}" Margin="7,0" Click="RemoveSelected_Click" />
                        <Button Content="↑" Style="{StaticResource SecondaryButton}" Width="40" Padding="0" Click="MoveUp_Click" />
                        <Button Content="↓" Style="{StaticResource SecondaryButton}" Width="40" Padding="0" Margin="5,0,0,0" Click="MoveDown_Click" />
                        <ToggleButton Content="↻" Style="{StaticResource PillToggle}" Width="42" MinWidth="42" Padding="0" Margin="7,0,0,0"
                                      IsChecked="{Binding QueueLoopEnabled, Mode=TwoWay}" ToolTip="Loopa spellistan från början" />
                        <ToggleButton Content="🔀" Style="{StaticResource PillToggle}" Width="42" MinWidth="42" Padding="0" Margin="5,0,0,0"
                                      IsChecked="{Binding QueueShuffleEnabled, Mode=TwoWay}" ToolTip="Blanda nästa låt" />
                        <Border Background="#15243A" BorderBrush="#405677" BorderThickness="1" CornerRadius="7" Margin="7,0,0,0" Padding="8,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ÖVERGÅNG" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBox x:Name="TransitionSecondsBox" Width="48" MinHeight="27" Padding="5,2" TextAlignment="Center"
                                         Text="{Binding QueueTransitionSeconds, Mode=OneWay, StringFormat=0.#}" TextChanged="TransitionSecondsBox_TextChanged" LostKeyboardFocus="TransitionSecondsBox_LostKeyboardFocus"
                                         ToolTip="Total övergångstid. 75 % används för fade ut och 25 % för fade in." />
                                <TextBlock Text="s" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="←" Style="{StaticResource PrimaryButton}" Width="44" Height="44" Padding="0" FontSize="20" ToolTip="Lägg till i kön" Click="AddSelected_Click" />
                <Button Content="↻" Style="{StaticResource SecondaryButton}" Width="44" Height="44" Padding="0" FontSize="18" Margin="0,7" ToolTip="Uppdatera" Click="Refresh_Click" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="TILLGÄNGLIGA LÅTAR OCH JINGLAR" Style="{StaticResource EyebrowText}" Margin="2,0,0,7" />
                    <ListBox x:Name="DeckFilterTabs" Grid.Row="1" Height="38" SelectionChanged="DeckFilterTabs_SelectionChanged" ItemContainerStyle="{StaticResource FilterTab}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox x:Name="SearchBox" Grid.Row="2" Margin="0,7" TextChanged="SearchBox_TextChanged" ToolTip="Sök titel" />
                    <ListBox x:Name="AvailableList" Grid.Row="3" MouseDoubleClick="AvailableList_MouseDoubleClick" PreviewMouseLeftButtonDown="AvailableList_PreviewMouseLeftButtonDown">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="5,7" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="FolderText" Grid.Row="2" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,9,0,0" />
    </Grid>
</UserControl>
