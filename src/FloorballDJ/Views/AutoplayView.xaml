<UserControl x:Class="FloorballDJ.Views.AutoplayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FloorballDJ.Views" Background="{StaticResource AppBackgroundBrush}" IsHitTestVisible="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="QueueBoolVisibility"/>
        <local:QueueRawFileConverter x:Key="RawFileChoice"/>
        <Style x:Key="QueueItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="QueueSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="7" Padding="5,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="QueueSurface" Property="Background" Value="#16283A" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="QueueSurface" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter TargetName="QueueSurface" Property="BorderBrush" Value="#6636E0B4" /><Setter TargetName="QueueSurface" Property="BorderThickness" Value="1" /></Trigger>
                            <Trigger Property="Tag" Value="DropBefore"><Setter TargetName="QueueSurface" Property="Background" Value="#2636E0B4" /><Setter TargetName="QueueSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="QueueSurface" Property="BorderThickness" Value="0,4,0,0" /></Trigger>
                            <Trigger Property="Tag" Value="DropAfter"><Setter TargetName="QueueSurface" Property="Background" Value="#2636E0B4" /><Setter TargetName="QueueSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="QueueSurface" Property="BorderThickness" Value="0,0,0,4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="14,12" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AUTOPLAY OCH SPELLISTOR" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Välj lista genom att klicka i den. Nästa låt fortsätter alltid inom listan som spelar." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="PreviewToggle" Content="🎧 FÖRLYSSNING" Style="{StaticResource PillToggle}" Margin="0,0,7,0"
                                  IsChecked="{Binding UseSecondaryOutput, Mode=OneWay}" Checked="PreviewToggle_Changed" Unchecked="PreviewToggle_Changed" />
                    <Button Content="Välj musikmapp" ToolTip="Lägg till musikfiler från en mapp i vald spellista" Style="{StaticResource SecondaryButton}" Click="ChooseMusicFolder_Click" />
                    <Button x:Name="NewPlaylistButton" Content="Ny spellista" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="NewPlaylist_Click" />
                    <Button Content="Ladda spellista" Style="{StaticResource SecondaryButton}" Margin="7,0" Click="LoadPlaylist_Click" />
                    <Button Content="Spara spellista" Style="{StaticResource PrimaryButton}" Click="SavePlaylist_Click" />
                </StackPanel>
                <Border x:Name="PreviewTransport" Background="#15243A" BorderBrush="#405677" BorderThickness="1" CornerRadius="7"
                        Padding="10,6" Margin="0,7,0,0" HorizontalAlignment="Right" MinWidth="560">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding UseSecondaryOutput}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="220"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FÖRLYSSNING · UTGÅNG 2" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviewTitle}" />
                        </StackPanel>
                        <Slider x:Name="PreviewPositionSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding PreviewPositionFraction, Mode=OneWay}"
                                Margin="10,0" VerticalAlignment="Center" PreviewMouseLeftButtonDown="PreviewPositionSlider_PreviewMouseLeftButtonDown"
                                ToolTip="Klicka för att hoppa i förlyssningen. Utgång 1 påverkas inte." />
                        <TextBlock Grid.Column="2" Text="{Binding PreviewTimeText}" FontFamily="Cascadia Mono" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="VOLYM" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <Slider Grid.Column="4" Minimum="-60" Maximum="12" Value="{Binding PreviewVolumeDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center" ToolTip="Volym endast för förlyssning på utgång 2" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Column="0" Padding="14" Margin="0,0,6,0" PreviewMouseLeftButtonDown="PlaylistPanel_PreviewMouseLeftButtonDown" GotKeyboardFocus="PlaylistPanel_GotKeyboardFocus" Tag="0">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardBorder}"><Style.Triggers><DataTrigger Binding="{Binding EditingQueueIndex}" Value="0"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,0,0,8"><TextBlock Text="KÖAD SPELORDNING · 1" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="{Binding LeftPlaylistTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ListBox x:Name="QueueList" Tag="0" ContextMenuOpening="Queue_ContextMenuOpening" Grid.Row="1" ItemsSource="{Binding LeftPlaybackQueue}" local:QueueRowNumbers.Enabled="True"
                             KeyDown="QueueList_KeyDown" MouseDoubleClick="QueueList_MouseDoubleClick" ItemContainerStyle="{StaticResource QueueItem}"
                             AllowDrop="True" PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown" PreviewMouseMove="QueueList_PreviewMouseMove"
                             DragOver="QueueList_DragOver" DragLeave="QueueList_DragLeave" Drop="QueueList_Drop">
                        <ListBox.ContextMenu><ContextMenu><MenuItem Header="Ändra sluttid…" Click="EditQueueEnd_Click"/></ContextMenu></ListBox.ContextMenu>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="14" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:QueueRowNumbers.Position)}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10">
                                        <TextBlock.Text><MultiBinding Converter="{StaticResource RawFileChoice}" ConverterParameter="summary"><Binding/><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.QueueClipOptionsRevision" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="Hela låten" FontSize="11" VerticalAlignment="Center" Click="RawFile_Click"
                                          ToolTip="Ignorera deckets start/slut. En egen sluttid i spellistan gäller fortfarande. Bytet används nästa gång låten startas.">
                                    <CheckBox.IsChecked><MultiBinding Converter="{StaticResource RawFileChoice}" Mode="OneWay"><Binding/><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.QueueClipOptionsRevision" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></CheckBox.IsChecked>
                                </CheckBox>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Padding="14" Margin="6,0,0,0" PreviewMouseLeftButtonDown="PlaylistPanel_PreviewMouseLeftButtonDown" GotKeyboardFocus="PlaylistPanel_GotKeyboardFocus" Tag="1">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardBorder}"><Style.Triggers><DataTrigger Binding="{Binding EditingQueueIndex}" Value="1"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,0,0,8"><TextBlock Text="KÖAD SPELORDNING · 2" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="{Binding RightPlaylistTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ListBox x:Name="RightQueueList" Tag="1" ContextMenuOpening="Queue_ContextMenuOpening" Grid.Row="1" ItemsSource="{Binding RightPlaybackQueue}" local:QueueRowNumbers.Enabled="True"
                             KeyDown="QueueList_KeyDown" MouseDoubleClick="QueueList_MouseDoubleClick" ItemContainerStyle="{StaticResource QueueItem}"
                             AllowDrop="True" PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown" PreviewMouseMove="QueueList_PreviewMouseMove"
                             DragOver="QueueList_DragOver" DragLeave="QueueList_DragLeave" Drop="QueueList_Drop">
                        <ListBox.ContextMenu><ContextMenu><MenuItem Header="Ändra sluttid…" Click="EditQueueEnd_Click"/></ContextMenu></ListBox.ContextMenu>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="14" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:QueueRowNumbers.Position)}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10">
                                        <TextBlock.Text><MultiBinding Converter="{StaticResource RawFileChoice}" ConverterParameter="summary"><Binding/><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.QueueClipOptionsRevision" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="Hela låten" FontSize="11" VerticalAlignment="Center" Click="RawFile_Click"
                                          ToolTip="Ignorera deckets start/slut. En egen sluttid i spellistan gäller fortfarande. Bytet används nästa gång låten startas.">
                                    <CheckBox.IsChecked><MultiBinding Converter="{StaticResource RawFileChoice}" Mode="OneWay"><Binding/><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.QueueClipOptionsRevision" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></CheckBox.IsChecked>
                                </CheckBox>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding PlaybackSourceLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,9,2,0"/>
            <TextBlock Grid.Row="1" Margin="2,9,10,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentBrush}"><Run Text="Verktyg för: "/><Run Text="{Binding EditingPlaylistTitle, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,9,0,0">
                        <Button Content="Spela nu" Style="{StaticResource PrimaryButton}" Click="PlaySelected_Click" />
                        <Button x:Name="PlayNextButton" Content="Spela nästa" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0"
                                ToolTip="Spela nästa låt i kön. När slumpning är på väljs en slumpmässig låt." Click="PlayNext_Click" />
                        <Button Content="Ta bort" Style="{StaticResource SecondaryButton}" Margin="7,0" Click="RemoveSelected_Click" />
                        <Button Content="↑" Style="{StaticResource SecondaryButton}" Width="40" Padding="0" Click="MoveUp_Click" />
                        <Button Content="↓" Style="{StaticResource SecondaryButton}" Width="40" Padding="0" Margin="5,0,0,0" Click="MoveDown_Click" />
                        <ToggleButton Content="↻" Style="{StaticResource PillToggle}" Width="42" MinWidth="42" Padding="0" Margin="7,0,0,0"
                                      IsChecked="{Binding QueueLoopEnabled, Mode=TwoWay}" ToolTip="Loopa spellistan från början" />
                        <ToggleButton Content="🔀" Style="{StaticResource PillToggle}" Width="42" MinWidth="42" Padding="0" Margin="5,0,0,0"
                                      IsChecked="{Binding QueueShuffleEnabled, Mode=TwoWay}" ToolTip="Blanda nästa låt" />
                        <Border Background="#15243A" BorderBrush="#405677" BorderThickness="1" CornerRadius="7" Margin="7,0,0,0" Padding="8,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="TransitionTypeCombo" Width="164" Height="31" MinHeight="31" Style="{StaticResource DarkComboBox}" SelectedIndex="{Binding QueueTransitionTypeIndex, Mode=TwoWay}" ToolTip="Typ av övergång">
                                    <ComboBoxItem Content="Crossfade"/><ComboBoxItem Content="Fade out / Fade in"/>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsQueueCrossfade, Converter={StaticResource QueueBoolVisibility}}">
                                    <TextBox x:Name="TransitionSecondsBox" Width="46" MinHeight="27" Padding="5,2" Margin="7,0,0,0" TextAlignment="Center"
                                         Text="{Binding QueueTransitionSeconds, Mode=OneWay, StringFormat=0.#}" TextChanged="TransitionSecondsBox_TextChanged" LostKeyboardFocus="TransitionSecondsBox_LostKeyboardFocus"
                                         ToolTip="Överlappningstid: den gamla låten tonas ut medan nästa tonas in under samma tid." />
                                    <TextBlock Text="s" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsQueueFadeInOut, Converter={StaticResource QueueBoolVisibility}}">
                                    <TextBlock Text="UT" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox x:Name="FadeOutSecondsBox" Width="44" MinHeight="27" Padding="4,2" TextAlignment="Center" Text="{Binding QueueFadeOutSeconds, Converter={StaticResource FlexibleDouble}, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="s  IN" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBox x:Name="FadeInSecondsBox" Width="44" MinHeight="27" Padding="4,2" TextAlignment="Center" Text="{Binding QueueFadeInSeconds, Converter={StaticResource FlexibleDouble}, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="s" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ChooseDeckSongsButton" Content="Välj från deck" Style="{StaticResource SecondaryButton}"
                                Margin="7,0,0,0" ToolTip="Välj låtar från deck och sidor till den aktuella kön utan att avbryta Autoplay."
                                Click="ChooseDeckSongs_Click" />
                        <Button x:Name="ClearPlaylistButton" Content="Rensa listan" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="ClearPlaylist_Click" />
                    </WrapPanel>
        </Grid>
        <TextBlock x:Name="FolderText" Grid.Row="2" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,9,0,0" />
    </Grid>
</UserControl>
