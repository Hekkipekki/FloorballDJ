<Window x:Class="FloorballDJ.Views.LanguageSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose language · Välj språk" Width="540" Height="390"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="34,30">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="WELCOME · VÄLKOMMEN" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="Choose your language" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,4" />
            <TextBlock Text="Välj språk för FloorballDJ" Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,0,0,26" />
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <RadioButton x:Name="EnglishChoice" IsChecked="True" GroupName="Language" FontSize="16">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🇬🇧" FontSize="22" Margin="0,0,12,0"/><TextBlock Text="English" VerticalAlignment="Center"/></StackPanel>
                </RadioButton>
            </Border>
            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <RadioButton x:Name="SwedishChoice" GroupName="Language" FontSize="16">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🇸🇪" FontSize="22" Margin="0,0,12,0"/><TextBlock Text="Svenska" VerticalAlignment="Center"/></StackPanel>
                </RadioButton>
            </Border>
        </StackPanel>
        <Button Grid.Row="1" Content="Continue · Fortsätt" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" MinWidth="170" IsDefault="True" Click="Continue_Click" />
    </Grid>
</Window>
