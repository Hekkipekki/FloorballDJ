<Window x:Class="FloorballDJ.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloorballDJ – uppdateringar" Width="620" Height="500" MinWidth="540" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PROGRAMUPPDATERING" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="Sök efter uppdateringar" Style="{StaticResource SectionTitle}" FontSize="28" Margin="0,4,0,4" />
            <TextBlock Text="Kontrollen startar bara när du öppnar detta fönster." Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20" Margin="0,20,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock x:Name="StateIcon" Text="↻" FontSize="25" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,2,0,0">
                        <TextBlock x:Name="StateTitle" Text="Kontrollerar…" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,18,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" LineHeight="21" />
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <ProgressBar x:Name="DownloadProgress" Height="9" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="DownloadStatusText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Installationen startas aldrig medan ljud spelas. Profilen sparas innan FloorballDJ stängs."
                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ReleaseNotesButton" Content="Ändringslogg" Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed" Click="ReleaseNotes_Click" />
                <Button x:Name="DownloadPageButton" Content="Öppna nedladdningssidan" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="DownloadPage_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Stäng" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="RetryButton" Content="Försök igen" Style="{StaticResource SecondaryButton}"
                        MinWidth="110" Visibility="Collapsed" Click="Retry_Click" />
                <Button x:Name="InstallButton" Content="Ladda ned och installera" Style="{StaticResource PrimaryButton}"
                        MinWidth="180" Visibility="Collapsed" Click="Install_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
