<Window x:Class="FloorballDJ.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloorballDJ – uppdateringar" Width="660" Height="550" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PROGRAMUPPDATERING" Style="{StaticResource EyebrowText}" />
            <TextBlock x:Name="HeadingText" Text="Sök efter uppdateringar" Style="{StaticResource SectionTitle}" FontSize="28" Margin="0,4,0,4" TextWrapping="Wrap" />
            <TextBlock x:Name="IntroText" Text="FloorballDJ kontrollerar även vid start. Du väljer själv när du vill uppdatera." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20" Margin="0,20,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock x:Name="StateIcon" Text="↻" FontSize="25" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,2,0,0">
                        <TextBlock x:Name="StateTitle" Text="Kontrollerar…" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="140" Margin="0,18,0,0">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" LineHeight="21" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <ProgressBar x:Name="DownloadProgress" Height="9" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="DownloadStatusText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Installationen startas aldrig medan ljud spelas. Du får hantera osparade ändringar innan FloorballDJ stängs."
                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12">
                <Button x:Name="ReleaseNotesButton" Content="Ändringslogg" Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed" Click="ReleaseNotes_Click" />
                <Button x:Name="DownloadPageButton" Content="Öppna nedladdningssidan" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="DownloadPage_Click" />
            </WrapPanel>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Stäng" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="0,0,8,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
                <Button x:Name="RetryButton" Content="Försök igen" Style="{StaticResource SecondaryButton}"
                        MinWidth="110" Visibility="Collapsed" Click="Retry_Click" />
                <Button x:Name="InstallButton" Content="Ladda ned och installera" Style="{StaticResource PrimaryButton}"
                        MinWidth="180" Visibility="Collapsed" Click="Install_Click" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
