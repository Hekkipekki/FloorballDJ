<Window x:Class="FloorballDJ.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inställningar" Width="720" Height="760" MinHeight="680"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ARBETSSTATION" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Inställningar" Style="{StaticResource SectionTitle}" FontSize="30" Margin="0,3,0,3" />
                <TextBlock Text="Anpassa ljud, profiler, slumpuppspelning och utseende efter din matchdag." Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <GroupBox Header="Ljud" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,16">
                    <Grid Margin="2,7,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Utgångsenhet  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Huvudutgången som publiken hör. Windows standardenhet följer den utgång som är vald i Windows." />
                        <ComboBox x:Name="OutputDeviceCombo" Grid.Column="1" ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding Draft.OutputDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  MaxDropDownHeight="320" Margin="0,5" Foreground="#111820" Background="White">
                            <ComboBox.Resources><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#111820" /><Setter Property="Background" Value="White" /></Style></ComboBox.Resources>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="Utgångsenhet 2  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Separat utgång för förlyssning, exempelvis hörlurar. Den används bara när förlyssningsläget är aktiverat." />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding Draft.SecondaryOutputDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  MaxDropDownHeight="320" Margin="0,5" ToolTip="Alternativ utgång, exempelvis hörlurar för förlyssning" Foreground="#111820" Background="White">
                            <ComboBox.Resources><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#111820" /><Setter Property="Background" Value="White" /></Style></ComboBox.Resources>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="Programvolym  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Övergripande gain för hela FloorballDJ. 0 dB betyder ingen extra ändring, inte att ljudsignalen ligger på digital maxnivå. Börja lågt och kalibrera mot hallens mixerbord eller PA." />
                        <Grid Grid.Row="2" Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <Slider Minimum="-60" Maximum="6" Value="{Binding Draft.MasterVolumeDb}" TickFrequency="6" TickPlacement="BottomRight"
                                    IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" Foreground="#7F93AD" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Draft.MasterVolumeDb, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="10,5,0,5" ToolTip="dB" />
                        </Grid>
                        <TextBlock Grid.Row="3" Text="Global fade in  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Hur många sekunder en ny låt normalt tonas in. En enskild jingle kan ha en egen tid som ersätter detta värde." />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Draft.FadeInSeconds, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="Sekunder" />
                        <TextBlock Grid.Row="4" Text="Global fade ut  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Hur många sekunder den spelande låten normalt tonas ut vid stopp eller byte. En enskild jingle kan ha en egen tid." />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Draft.FadeOutSeconds, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="Sekunder" />
                        <TextBlock Grid.Row="5" Text="Standard loudness  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Målnivån som används vid automatisk LUFS-balansering. −16 LUFS är en trygg och tydlig startpunkt för idrottshall. Ett värde närmare 0 låter starkare men ger mindre dynamik och säkerhetsmarginal." />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Draft.DefaultLoudnessTargetLufs, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="Rekommenderad start för idrottshall: −16 LUFS. Detta ändrar inte originalfilerna; en fast uppspelningsgain sparas per analyserad jingle." />
                        <TextBlock Grid.Row="6" Text="Säkerhetslimiter  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Fångar plötsliga toppar som annars kan ge digital överstyrning. Låt normalt denna vara aktiverad. Den ersätter inte korrekt nivåinställning på PA-systemet." />
                        <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding Draft.MasterLimiterEnabled}" Content="Skydda utgången mot digital överstyrning" VerticalAlignment="Center" ToolTip="Rekommenderas aktiverad under match och evenemang." />
                        <TextBlock Grid.Row="7" Text="Limiter-tak  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Högsta tillåtna toppnivå före utgången. −1 dBTP är normal säkerhetsmarginal; −2 dBTP ger extra marginal för idrottshall och enklare PA-system." />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Draft.MasterLimiterCeilingDbtp, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="Ange dBTP. Rekommenderat: −1 normalt eller −2 för extra säkerhetsmarginal i idrottshall." />
                        <TextBlock Grid.Row="8" Text="Automatiskt mixutrymme  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Skapar säkerhetsmarginal när flera ljud avsiktligt spelas samtidigt, exempelvis Mix eller Duck. En låt som bara tonas ut vid ett normalt byte påverkar inte längre den nya låtens nivå." />
                        <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding Draft.AutoMixHeadroomEnabled}" Content="Sänk säkert när flera ljud spelas samtidigt" VerticalAlignment="Center" ToolTip="Låt normalt detta vara aktiverat. Auto gain för en enskild låt hålls fast och ändras inte under vanlig crossfade." />
                        <TextBlock Grid.Row="9" Text="PA/Talk-dämpning  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Hur mycket musiken sänks när PA/Talk är aktiv. −15 dB brukar lämna tydligt utrymme för tal utan att musiken försvinner helt." />
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Draft.TalkDuckLevelDb, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="dB, rekommenderad start: −15" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Profiler" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,16">
                    <Grid Margin="2,7,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Standardprofil  ⓘ" Style="{StaticResource FieldLabel}"
                                   ToolTip="Profilen som öppnas automatiskt när FloorballDJ startar. Om ingen standardprofil är vald återställs den vanliga autosparningen." />
                        <Grid Grid.Column="1" Margin="0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="DefaultProfilePathText" Text="{Binding DefaultProfilePath}" IsReadOnly="True"
                                     ToolTip="Ingen sökväg betyder att FloorballDJ använder den vanliga autosparningen." />
                            <Button Grid.Column="1" Content="Välj…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="ChooseDefaultProfile_Click" />
                            <Button Grid.Column="2" Content="Ingen standard" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="ClearDefaultProfile_Click" />
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"
                                   Text="Standardprofilen öppnas först vid start. De fem senast använda profilerna visas under Profil i menyraden." />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Slumpmässig låtspelare" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,16">
                    <StackPanel Margin="2,7,2,2">
                        <TextBlock Text="Skapa en global pool som spelar en slumpvald jingle med en enda snabbtangent. Markera hela deck eller välj enskilda jinglar."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Snabbtangent" Style="{StaticResource FieldLabel}" ToolTip="Första trycket spelar en slumpvald jingle. Nästa tryck tonar ut den och följande tryck väljer en ny." />
                            <Border Grid.Column="1" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="12,7" MinWidth="92" VerticalAlignment="Center">
                                <TextBlock x:Name="RandomPoolShortcutText" Text="&lt;Ingen&gt;" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="2" Content="Välj snabbtangent" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ChooseRandomPoolShortcut_Click" />
                        </Grid>
                        <TextBlock Text="INNEHÅLL I POOLEN" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,2,0,5" />
                        <ItemsControl ItemsSource="{Binding RandomPoolDecks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                        <Expander IsExpanded="False">
                                            <Expander.Header>
                                                <CheckBox IsChecked="{Binding IncludeWholeDeck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Content="{Binding Name}" FontWeight="SemiBold"
                                                          ToolTip="Inkludera alla spelbara jinglar i detta deck, även jinglar som läggs till senare." />
                                            </Expander.Header>
                                            <StackPanel Margin="24,8,0,2">
                                                <TextBlock Text="Enskilda jinglar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,5" />
                                                <ItemsControl ItemsSource="{Binding Jingles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Content="{Binding Title}" Margin="0,3" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="12,9" Margin="0,2,0,0">
                            <TextBlock Text="Ett markerat deck inkluderar hela decket. Du kan dessutom markera enskilda jinglar från andra deck. Textblock och tomma platser ignoreras automatiskt."
                                       Foreground="{StaticResource AccentBrush}" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Typografi" Style="{StaticResource ModernGroupBox}">
                    <Grid Margin="2,7,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Typsnitt" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Fonts}" SelectedValuePath="Value"
                                  SelectedValue="{Binding Draft.FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"
                                  Foreground="#111820" Background="White">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#111820" /><Setter Property="Background" Value="White" /></Style>
                            </ComboBox.Resources>
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding DisplayName}" FontFamily="{Binding PreviewFont}" Foreground="#111820" FontSize="14" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="Titelstorlek" Style="{StaticResource FieldLabel}" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Draft.TitleFontSize, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="Pixlar" />
                        <TextBlock Grid.Row="2" Text="Egna typsnitt" Style="{StaticResource FieldLabel}" />
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FontFolderPath, Mode=OneWay}" IsReadOnly="True" ToolTip="Lägg .ttf- eller .otf-filer i den här mappen" />
                            <Button Grid.Column="1" Content="Öppna mapp" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenFontFolder_Click" />
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
                            <TextBlock x:Name="FontStatusText" Text="Lägg till .ttf eller .otf och klicka sedan på Uppdatera." Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                            <Button Content="Uppdatera" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="ReloadFonts_Click" />
                        </Grid>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="Ändringarna används direkt när du sparar." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Avbryt" Style="{StaticResource SecondaryButton}" MinWidth="104" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Spara inställningar" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
