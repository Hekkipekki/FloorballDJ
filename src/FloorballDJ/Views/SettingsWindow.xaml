<Window x:Class="FloorballDJ.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FloorballDJ.Controls"
        xmlns:conv="clr-namespace:FloorballDJ.Converters"
        Title="Inställningar" Width="720" Height="760" MinHeight="680"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
    <Window.Resources>
        <conv:FontFamilyValueConverter x:Key="PreviewFontFamily" />
        <BooleanToVisibilityConverter x:Key="PreviewVisibility" />
    </Window.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ARBETSSTATION" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Inställningar" Style="{StaticResource SectionTitle}" Margin="0,3,0,3" />
                <TextBlock Text="Anpassa ljud, profiler, slumpuppspelning och utseende efter din matchdag." Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <GroupBox Header="Språk / Language" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,16">
                    <Grid Margin="2,7,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Programspråk" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding LanguageCode, Mode=TwoWay}" Margin="0,5" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Språkbytet används nästa gång FloorballDJ startas."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="Ljud" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,16">
                    <Grid Margin="2,7,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <controls:InfoLabel Text="Utgångsenhet" HelpText="Huvudutgången som publiken hör. Windows standardenhet följer den utgång som är vald i Windows." />
                        <ComboBox x:Name="OutputDeviceCombo" Grid.Column="1" ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding Draft.OutputDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  MaxDropDownHeight="320" Margin="0,5" />
                        <controls:InfoLabel Grid.Row="1" Text="Utgångsenhet 2" HelpText="Separat utgång för förlyssning, exempelvis hörlurar. Den används bara när förlyssningsläget är aktiverat." />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding Draft.SecondaryOutputDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  MaxDropDownHeight="320" Margin="0,5" ToolTip="Alternativ utgång, exempelvis hörlurar för förlyssning" />
                        <controls:InfoLabel Grid.Row="2" Text="Global fade in" HelpText="Hur många sekunder en ny låt normalt tonas in. En enskild jingle kan ha en egen tid som ersätter detta värde." />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Draft.FadeInSeconds, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="Sekunder" />
                        <controls:InfoLabel Grid.Row="3" Text="Global fade ut" HelpText="Hur många sekunder den spelande låten normalt tonas ut vid stopp eller byte. En enskild jingle kan ha en egen tid." />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Draft.FadeOutSeconds, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="Sekunder" />
                        <controls:InfoLabel Grid.Row="4" Text="Standard loudness" HelpText="Målnivån som används vid automatisk LUFS-balansering. −16 LUFS är en trygg och tydlig startpunkt för idrottshall. Ett värde närmare 0 låter starkare men ger mindre dynamik och säkerhetsmarginal." />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Draft.DefaultLoudnessTargetLufs, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="Rekommenderad start för idrottshall: −16 LUFS. Detta ändrar inte originalfilerna; en fast uppspelningsgain sparas per analyserad jingle." />
                        <controls:InfoLabel Grid.Row="5" Text="Säkerhetslimiter" HelpText="Fångar plötsliga toppar som annars kan ge digital överstyrning. Låt normalt denna vara aktiverad. Den ersätter inte korrekt nivåinställning på PA-systemet." />
                        <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Draft.MasterLimiterEnabled}" Content="Skydda utgången mot digital överstyrning" VerticalAlignment="Center" ToolTip="Rekommenderas aktiverad under match och evenemang." />
                        <controls:InfoLabel Grid.Row="6" Text="Limiter-tak" HelpText="Högsta tillåtna toppnivå före utgången. −1 dBTP är normal säkerhetsmarginal; −2 dBTP ger extra marginal för idrottshall och enklare PA-system." />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Draft.MasterLimiterCeilingDbtp, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="Ange dBTP. Rekommenderat: −1 normalt eller −2 för extra säkerhetsmarginal i idrottshall." />
                        <controls:InfoLabel Grid.Row="7" Text="Automatiskt mixutrymme" HelpText="Skapar säkerhetsmarginal när flera ljud avsiktligt spelas samtidigt, exempelvis Mix eller Duck. En låt som bara tonas ut vid ett normalt byte påverkar inte längre den nya låtens nivå." />
                        <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding Draft.AutoMixHeadroomEnabled}" Content="Sänk säkert när flera ljud spelas samtidigt" VerticalAlignment="Center" ToolTip="Låt normalt detta vara aktiverat. Auto gain för en enskild låt hålls fast och ändras inte under vanlig crossfade." />
                        <controls:InfoLabel Grid.Row="8" Text="PA/Talk-dämpning" HelpText="Hur mycket musiken sänks när PA/Talk är aktiv. −15 dB brukar lämna tydligt utrymme för tal utan att musiken försvinner helt." />
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Draft.TalkDuckLevelDb, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,5" ToolTip="dB, rekommenderad start: −15" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Profiler" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,16">
                    <Grid Margin="2,7,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <controls:InfoLabel Text="Standardprofil"
                                            HelpText="Profilen som öppnas automatiskt när FloorballDJ startar. Om ingen standardprofil är vald återställs den vanliga autosparningen." />
                        <Grid Grid.Column="1" Margin="0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="DefaultProfilePathText" Text="{Binding DefaultProfilePath}" IsReadOnly="True"
                                     ToolTip="Ingen sökväg betyder att FloorballDJ använder den vanliga autosparningen." />
                            <Button Grid.Column="1" Content="Välj…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="ChooseDefaultProfile_Click" />
                            <Button Grid.Column="2" Content="Ingen standard" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="ClearDefaultProfile_Click" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Senast använda" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RecentProfilesCombo" Style="{StaticResource DarkComboBox}" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RecentProfiles}" DisplayMemberPath="Name"
                                  SelectedValuePath="Path" SelectionChanged="RecentProfilesCombo_SelectionChanged" Margin="0,5"
                                  ToolTip="Välj en av de fem senast använda profilerna som standardprofil" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                   Text="Standardprofilen öppnas först vid start. De fem senast använda profilerna visas under Profil i menyraden." />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Autoplay" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,16">
                    <StackPanel Margin="2,7,2,2">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Autoplay-lista" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AutoplayProfiles}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedAutoplayProfile, Mode=TwoWay}" Margin="0,4" />
                            <Button Grid.Column="2" Content="+ Ny" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Click="AddAutoplayProfile_Click" />
                            <Button Grid.Column="3" Content="Ta bort" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Click="RemoveAutoplayProfile_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Namn" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding SelectedAutoplayProfile.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                            <TextBlock Grid.Column="2" Text="Snabbtangent" Style="{StaticResource FieldLabel}" Margin="18,0,8,0" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7" MinWidth="82" Margin="0,4">
                                    <TextBlock Text="{Binding SelectedAutoplayProfile.ShortcutDisplay}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                                <Button Content="Välj" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Click="ChooseAutoplayShortcut_Click" />
                                <Button Content="×" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Padding="10,5" ToolTip="Ta bort snabbtangent" Click="ClearAutoplayShortcut_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <controls:InfoLabel Text="Spellista" HelpText="Spellistan som laddas när den valda snabbtangenten används." />
                            <TextBox Grid.Column="1" Text="{Binding SelectedAutoplayProfile.PlaylistPath}" IsReadOnly="True" Margin="0,4" />
                            <Button Grid.Column="2" Content="Välj…" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Click="ChooseAutoplayPlaylist_Click" />
                            <Button Grid.Column="3" Content="×" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Padding="10,5" ToolTip="Ta bort spellistan" Click="ClearAutoplayPlaylist_Click" />
                            <controls:InfoLabel Grid.Column="4" Text="Volym (dB)" Margin="18,0,8,0"
                                                HelpText="0 dB är oförändrat. Ett negativt värde, exempelvis −8 dB, ger lugnare pausmusik utan att ändra originalfilerna." />
                            <TextBox Grid.Column="5" Text="{Binding SelectedAutoplayProfile.VolumeDb, Converter={StaticResource FlexibleDouble}, Mode=TwoWay}" Margin="0,4" TextAlignment="Center" />
                        </Grid>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                   Text="Varje Autoplay-lista har egen spellista, snabbtangent och volym. Tangenten öppnar Autoplay, ersätter kön och startar första låten automatiskt." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Typografi" Style="{StaticResource ModernGroupBox}">
                    <Grid Margin="2,7,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Typsnitt" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Fonts}" SelectedValuePath="Value"
                                  SelectedValue="{Binding Draft.FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding DisplayName}" FontFamily="{Binding PreviewFont}" Foreground="{StaticResource TextBrush}" FontSize="14" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="Titelstorlek" Style="{StaticResource FieldLabel}" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Draft.TitleFontSize, Converter={StaticResource FlexibleDouble}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" ToolTip="Pixlar (9–40)" />
                        <TextBlock Grid.Row="2" Text="Egna typsnitt" Style="{StaticResource FieldLabel}" />
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FontFolderPath, Mode=OneWay}" IsReadOnly="True" ToolTip="Lägg .ttf- eller .otf-filer i den här mappen" />
                            <Button Grid.Column="1" Content="Öppna mapp" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenFontFolder_Click" />
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
                            <TextBlock x:Name="FontStatusText" Text="Lägg till .ttf eller .otf och klicka sedan på Uppdatera." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                            <Button Content="Uppdatera" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="ReloadFonts_Click" />
                        </Grid>
                        <CheckBox Grid.Row="4" Grid.Column="1" Content="Visa jinglarnas längd i hörnet"
                                  IsChecked="{Binding Draft.ShowJingleDuration, Mode=TwoWay}" Margin="0,16,0,8" />
                        <TextBlock Grid.Row="5" Text="Förhandsvisning" Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="5" Grid.Column="1" Width="260" Height="120" HorizontalAlignment="Left"
                                Background="#FFAB82" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="8" Margin="0,5">
                            <Grid>
                                <TextBlock x:Name="TypographyPreview" Text="En längre jingletitel som får plats på flera rader"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center"
                                           Foreground="Black" FontWeight="SemiBold"
                                           FontFamily="{Binding Draft.FontFamily, Converter={StaticResource PreviewFontFamily}}"
                                           FontSize="{Binding Draft.TitleFontSize}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Draft.ShowJingleDuration}" Value="True"><Setter Property="Margin" Value="0,18" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Background="#28000000" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="{Binding Draft.ShowJingleDuration, Converter={StaticResource PreviewVisibility}}">
                                    <TextBlock Text="02:49" Foreground="Black" FontFamily="Cascadia Mono" FontSize="11" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="Ändringarna används direkt när du sparar." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Avbryt" Style="{StaticResource SecondaryButton}" MinWidth="104" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Spara inställningar" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
