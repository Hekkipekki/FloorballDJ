<Window x:Class="FloorballDJ.Views.LoudnessBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Balansera ljudbibliotek" Width="1050" Height="700" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterOwner"
        ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
    <Grid Margin="22,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="LOUDNESS OCH SÄKER NIVÅ" Style="{StaticResource EyebrowText}"/>
            <TextBlock Text="Analysera och balansera ljudbibliotek" Style="{StaticResource SectionTitle}" FontSize="27"/>
            <TextBlock Text="Originalfilerna ändras aldrig. FloorballDJ sparar endast analys och uppspelningsgain i profilen." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,14,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Målnivå  ⓘ" Style="{StaticResource FieldLabel}" ToolTip="Önskad genomsnittlig upplevd ljudstyrka i LUFS. För idrottshall rekommenderas normalt −16 LUFS. Värden upp till 0 tillåts, men peak-taket och maximal Auto gain skyddar mot överstyrning."/>
                <TextBox x:Name="TargetBox" Grid.Column="1" Text="-16" TextAlignment="Center" ToolTip="Tillåtet intervall är −30 till 0 LUFS. Ett högt mål kan inte alltid nås utan att passera peak-taket."/>
                <TextBlock Grid.Column="2" Text="Peak-tak  ⓘ" Style="{StaticResource FieldLabel}" Margin="18,0,0,0" ToolTip="Högsta tillåtna verkliga ljudtopp i dBTP. För idrottshall rekommenderas −2 dBTP för extra marginal till PA-systemet."/>
                <TextBox x:Name="PeakBox" Grid.Column="3" Text="-1" TextAlignment="Center" ToolTip="True-peak-tak i dBTP. FloorballDJ begränsar Auto gain så att den analyserade toppen inte beräknas passera detta värde."/>
                <TextBlock x:Name="SummaryText" Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="18,0"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Content="Analysera" Style="{StaticResource SecondaryButton}" Click="AnalyzeOnly_Click" ToolTip="Mäter filerna och visar värden, men aktiverar inte automatisk nivåjustering."/>
                    <Button Content="Analysera och balansera" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AnalyzeAndBalance_Click" ToolTip="Mäter filerna och aktiverar den föreslagna Auto gain-justeringen. Originalfilerna ändras inte."/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="36" Padding="12,5" TextChanged="SearchBox_TextChanged"
                     ToolTip="Sök på låttitel, filnamn eller deck" />
            <TextBlock Grid.Column="1" x:Name="SearchSummaryText" VerticalAlignment="Center" Margin="12,0,3,0"
                       Foreground="{StaticResource MutedBrush}" />
        </Grid>
        <ListView x:Name="FilesList" Grid.Row="3" ItemsSource="{Binding Items}" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}">
            <ListView.View><GridView>
                <GridViewColumn Header="Välj" Width="58">
                    <GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Deck" DisplayMemberBinding="{Binding Deck}" Width="120"/>
                <GridViewColumn Header="Titel" DisplayMemberBinding="{Binding Title}" Width="260"/>
                <GridViewColumn DisplayMemberBinding="{Binding Lufs}" Width="90"><GridViewColumn.Header><TextBlock Text="LUFS  ⓘ" ToolTip="Filens upplevda genomsnittliga ljudstyrka. Ett värde nära 0 är mycket starkt; exempelvis är −16 LUFS betydligt lugnare än −6 LUFS."/></GridViewColumn.Header></GridViewColumn>
                <GridViewColumn DisplayMemberBinding="{Binding Peak}" Width="100"><GridViewColumn.Header><TextBlock Text="True peak  ⓘ" ToolTip="Filens högsta beräknade verkliga topp. Positiva värden över 0 dBTP visar risk för överstyrning vid konvertering eller uppspelning."/></GridViewColumn.Header></GridViewColumn>
                <GridViewColumn DisplayMemberBinding="{Binding Gain}" Width="105"><GridViewColumn.Header><TextBlock Text="Auto gain  ⓘ" ToolTip="Den automatiska volymändringen vid uppspelning. Minus sänker en stark fil och plus höjer en tyst fil. Höjningen begränsas alltid av peak-taket. Originalfilen ändras inte."/></GridViewColumn.Header></GridViewColumn>
                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="230"/>
            </GridView></ListView.View>
        </ListView>
        <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="1"/><TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0">
                <Button x:Name="SelectAllButton" Content="Markera alla" Style="{StaticResource SecondaryButton}" Click="SelectAll_Click" />
                <Button x:Name="SelectNoneButton" Content="Avmarkera alla" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SelectNone_Click" />
                <Button x:Name="CancelAnalysisButton" Content="Avbryt analys" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="CancelAnalysis_Click"/>
                <Button Content="Stäng" Style="{StaticResource SecondaryButton}" MinWidth="90" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
