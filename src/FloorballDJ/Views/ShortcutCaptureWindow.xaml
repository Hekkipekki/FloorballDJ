<Window x:Class="FloorballDJ.Views.ShortcutCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Välj snabbknapp" Width="440" Height="245" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Capture_PreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="VÄLJ SNABBKNAPP" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Tryck den tangent eller kombination du vill använda." FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="Ctrl, Shift, Alt och Win väntar på ytterligare en tangent." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="#17243A" BorderBrush="#405677" BorderThickness="1" CornerRadius="10" Margin="0,16" Padding="14">
            <TextBlock x:Name="PressedText" Text="Väntar på tangent …" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#36E0B4" FontFamily="Cascadia Mono" FontSize="21" FontWeight="Bold" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Rensa" Click="Clear_Click" Margin="0,0,8,0" />
            <Button Content="Avbryt" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
