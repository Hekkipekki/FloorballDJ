<Window x:Class="FloorballDJ.Views.RandomFollowUpPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Välj automatiska följdlåtar" Width="920" Height="680" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="AUTOMATISK FÖLJDLÅT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Välj vad som får starta när den slumpade låten spelat färdigt" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" />
            <TextBlock Text="Om flera låtar markeras väljs en av dem slumpmässigt. Manuell fade eller stopp startar aldrig en följdlåt."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Padding="12,8" TextChanged="SearchBox_TextChanged" ToolTip="Sök på låt eller deck" />
            <Button Grid.Column="1" Content="A–Ö" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SortAscending_Click" />
            <Button Grid.Column="2" Content="Ö–A" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="SortDescending_Click" />
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8">
            <ListBox x:Name="ItemsList" ItemsSource="{Binding VisibleItems}" BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="8" Margin="2">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                <TextBlock Grid.Column="1" Text="{Binding DeckName}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono" HorizontalAlignment="Right" />
                            </Grid>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="SelectedCountText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Avbryt" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Använd valda" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
