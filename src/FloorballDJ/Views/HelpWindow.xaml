<Window x:Class="FloorballDJ.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hjälp – FloorballDJ" Width="1180" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="HelpGroup" TargetType="GroupBox" BasedOn="{StaticResource ModernGroupBox}">
            <Setter Property="Margin" Value="0,0,0,13" />
        </Style>
        <Style x:Key="HelpBody" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style x:Key="HelpMuted" TargetType="TextBlock" BasedOn="{StaticResource HelpBody}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="HelpNavItem" TargetType="ListBoxItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#17253A" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Border Padding="26,18" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HJÄLPCENTER" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="Så använder du FloorballDJ" Style="{StaticResource SectionTitle}" FontSize="28" Margin="0,3,0,2" />
                    <TextBlock Text="Kom igång, lär dig arbetsflödet och slå upp funktioner under matchen." Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="13,8" VerticalAlignment="Center">
                    <TextBlock Text="RC-GUIDE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#0B1524" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0" Padding="16,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="SÖK I HJÄLPCENTRET" Style="{StaticResource FieldLabel}" Margin="9,0,0,7" />
                    <TextBox x:Name="HelpSearchBox" Grid.Row="1" Padding="10,7" Margin="0,0,0,12"
                             TextChanged="HelpSearchBox_TextChanged" ToolTip="Sök efter en funktion eller uppgift" />
                    <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="NavigationSections" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="GRUNDLÄGGANDE" Style="{StaticResource FieldLabel}" Margin="9,2,0,4" />
                            <ListBox x:Name="HelpNavigation" SelectionChanged="HelpNavigation_SelectionChanged"
                                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource HelpNavItem}">
                                <ListBoxItem Tag="quick"><TextBlock Text="01  Snabbstart" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="playback"><TextBlock Text="02  Uppspelning" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="decks"><TextBlock Text="03  Decks och jinglar" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="autoplay"><TextBlock Text="04  Autoplay och köer" FontWeight="SemiBold" /></ListBoxItem>
                            </ListBox>
                            <TextBlock Text="AVANCERAT" Style="{StaticResource FieldLabel}" Margin="9,12,0,4" />
                            <ListBox x:Name="AdvancedNavigation" SelectionChanged="HelpNavigation_SelectionChanged"
                                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource HelpNavItem}">
                                <ListBoxItem Tag="random"><TextBlock Text="05  Slumpgrupper" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="audio"><TextBlock Text="06  Ljud och balansering" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="builder"><TextBlock Text="07  Jinglebyggare och långmix" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="properties"><TextBlock Text="08  Jingle-egenskaper" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="team"><TextBlock Text="09  Team Deck" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="profiles"><TextBlock Text="10  Profiler och backup" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="shortcuts"><TextBlock Text="11  Kortkommandon" FontWeight="SemiBold" /></ListBoxItem>
                            </ListBox>
                            <TextBlock Text="SUPPORT" Style="{StaticResource FieldLabel}" Margin="9,12,0,4" />
                            <ListBox x:Name="SupportNavigation" SelectionChanged="HelpNavigation_SelectionChanged"
                                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource HelpNavItem}">
                                <ListBoxItem Tag="license"><TextBlock Text="12  Licens och uppdatering" FontWeight="SemiBold" /></ListBoxItem>
                                <ListBoxItem Tag="troubleshooting"><TextBlock Text="13  Felsökning" FontWeight="SemiBold" /></ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="SearchResultsPanel" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock x:Name="SearchStatusText" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,7" />
                        <ListBox x:Name="SearchResultsList" Grid.Row="1" SelectionChanged="SearchResultsList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource HelpNavItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" /></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="24,18,24,8">
                <!-- 01 Snabbstart -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="QuickStartPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="SNABBSTART" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Från tom profil till matchklar" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="1. Välj ljudutgång" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna <Run FontWeight="Bold">Verktyg → Inställningar</Run>. Välj publikens ljudutgång och vid behov Utgångsenhet 2 för hörlurar. Börja med låg programvolym och kalibrera mot mixerbordet eller hallens PA.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="2. Skapa eller öppna en profil" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">En profil innehåller decks, knappar, färger, start/slut, snabbtangenter och ljudinställningar. Välj <Run FontWeight="Bold">Profil → Nytt projekt</Run>, öppna en befintlig profil eller importera en Snap XML-profil.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="3. Lägg till ljud" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Klicka på en tom knapp och välj en eller flera ljudfiler. Du kan även dra flera filer från Utforskaren till en knapp. Filerna placeras från den valda platsen och en extra rad skapas om decket blir fullt.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="4. Kontrollera nivåerna" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna <Run FontWeight="Bold">Verktyg → Analysera och balansera ljud</Run>. För idrottshall är <Run FontWeight="Bold">−16 LUFS</Run> och <Run FontWeight="Bold">−1 till −2 dBTP</Run> en bra start. Analysera mäter; Analysera och balansera aktiverar en fast Auto gain per jingle. Originalfilerna ändras aldrig.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="5. Testa före publikinsläpp" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Aktivera Förlyssning om du vill testa i hörlurar. Kontrollera Solo/Mix/Duck, fades, start/slut och snabbtangenter. Skapa därefter en projekt- och mediabackup som reserv.</TextBlock>
                        </GroupBox>
                        <Border Background="#1836E0B4" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
                            <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Matchcheck: " />rätt utgång • huvudvolym testad • Session aktiverad • saknade filer = 0 • backup skapad.</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 02 Uppspelning -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="PlaybackPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="UPPSPELNING" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Spela tryggt under match" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Jingleknappar" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Klicka på en knapp för att spela. Den aktiva knappen ser intryckt ut och pulserar. Klicka på samma knapp igen för att tona ut den. Klicka på en annan Solo-jingle för att crossfadea enligt global eller egen fade-tid.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Transportfältet" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Stopp:" /> stoppar allt direkt. <Run FontWeight="Bold" Text="Fade:" /> tonar ut allt. <Run FontWeight="Bold" Text="Paus/Play:" /> använder globala fade-tider.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,6,0,0">Klicka i huvudwaveformen för att hoppa i låten. L/R visar korta stereotoppar: grönt är normal arbetsnivå, gult betyder att en kort topp närmar sig digital maxnivå och rött är limiter-/klippområdet. Flera gula staplar kan därför förekomma även när två låtar har samma LUFS, eftersom LUFS mäter upplevd medelnivå. Huvudgain ändras direkt i transportfältet.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,6,0,0">Den digitala klockan i titelraden följer datorns lokala tid. Högerklicka på <Run FontWeight="Bold">KÖ</Run> för att rensa hela den aktiva kön eller ta bort en bestämd kommande låt.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="PA/Talk" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Mikrofonknappen tonar mjukt ned huvudutgången medan speakern talar och tonar upp den igen vid nästa klick. PA/Talk stängs också automatiskt av när en ny Solo-jingle startas, så nästa låt spelas på normal nivå. Dämpningen ställs under <Run FontWeight="Bold">Verktyg → Inställningar → PA/Talk-dämpning</Run>. Förlyssningsutgången påverkas inte. Håll <Run FontWeight="Bold">Ctrl+↑/↓</Run> för att höja eller sänka huvudvolymen i steg om 0,5 dB.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Space i deck-vyn" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Utan kö: Space tonar ut och sparar positionen i <Run FontWeight="Bold">två minuter</Run>; nästa Space återupptar samma låt där toningen slutade. Med Ctrl-kö: första Space tonar ut aktuell låt och nästa Space startar nästa köade jingle.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Spellägen" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Solo – " />normalvalet. Ersätter/crossfadear den låt som redan spelas.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,4,0,0"><Run FontWeight="Bold" Text="Mix – " />får spelas samtidigt med befintligt ljud, exempelvis mål- eller publikeffekter.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,4,0,0"><Run FontWeight="Bold" Text="Duck – " />spelas samtidigt och dämpar bakgrundsljudet enligt Duck-nivån.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Session och förlyssning" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Session" /> startar automatiskt varje gång FloorballDJ öppnas och markerar spelade jinglar med en grön punkt. Slumpgrupper, globala slumpknappar och Autoplays Shuffle prioriterar jinglar som ännu inte har spelats; när alla i den aktuella poolen är spelade används hela poolen igen. När Session stängs av rensas markeringarna. <Run FontWeight="Bold" Text="Förlyssning" /> gör att nya ljud spelas via Utgångsenhet 2. När läget stängs av stoppas förlyssningsljudet innan huvudutgången återaktiveras.</TextBlock>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- 03 Decks -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="DecksPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="DECKS OCH JINGLAR" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Bygg en tydlig matchlayout" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Lägga till och flytta" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Klicka på en tom plats för att välja filer eller dra en/flera ljudfiler från Utforskaren. Högerklicka på en tom plats och välj Lägg till textblock för en rubrik eller avdelare som inte kan spelas, köas eller visas i Autoplay. Dra en befintlig knapp eller ett textblock till en annan plats för att byta plats. Ändringar autosparas.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Högerklick på en jingle" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna egenskaper, ladda/byta ljud, ändra knapp- och textfärg, använda färg på en hel rad, kopiera/klistra in, välja Solo/Mix/Duck eller ta bort jingeln. Du kan markera flera knappar och ändra deras utseende tillsammans. Vid inklistring varnar FloorballDJ om samma ljud och inställningar redan finns i profilen. Att ta bort jingeln raderar inte ljudfilen från disken.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Deckflikar" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Högerklicka på en deckflik för att byta namn, lägga till, ta bort, sortera A–Ö/Ö–A, ändra hela deckets utseende eller ändra rader/kolumner. Varje sida kan ha en egen rad- och kolumnlayout. Om utrymmet minskas flyttas jinglar som inte längre får plats vidare och FloorballDJ skapar automatiskt fler sidor vid behov. Ett deck med flera sidor visar 1, 2, 3 under namnet. Klicka på ett nummer eller scrolla över deckfliken för att byta sida. Senast aktiva sida sparas i profilen. Du kan också dra en jingle till ett sidnummer för att flytta den till sidans första lediga plats. Sökning och snabbtangenten Hoppa till öppnar automatiskt rätt deck och sida.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Team Deck" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna <Run FontWeight="Bold">Verktyg → Team Deck</Run> för att skapa ett eller flera lag i den aktuella profilen. Välj lagnamn, snabbtangent och lagets standardjingle, och lägg sedan till spelare med varsin övergångsjingle. När snabbtangenten trycks spelas standardjingeln och en separat stream deck-liknande spelarvy öppnas. Klicka på en spelare för att spela spelarens ljud med profilens vanliga fade-regler. Team Deck följer profilen och en komplett flyttbackup.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Sökning och slumpkategorier" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold">Ctrl+F</Run> söker över alla deck och växlar till samt markerar bästa träffen. Tryck <Run FontWeight="Bold">Enter</Run> för att spela den markerade träffen, pil ned eller Tab för nästa träff och Esc för att stänga sökningen. Dra en deckflik till en annan flik för att ändra deckordningen. Under <Run FontWeight="Bold">Verktyg → Slumpmässig låtspelare</Run> finns en separat arbetsvy där du kan skapa flera namngivna slumpgrupper, exempelvis Mål och Utvisning. Överst kan du skapa separata slumpprofiler för olika lag som använder samma musikprofil; varje slumpprofil har egna grupper, pooler och snabbtangenter och endast den aktiva uppsättningen lyssnar på tangenterna. Sök och markera hela deck eller enskilda jinglar och följ poolens innehåll i översikten till höger. Första trycket spelar slumpmässigt, andra tonar ut och tredje väljer nästa. Jingle-egenskaper har dessutom separata slumpkategorier för situationsspecifika grupper.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Kö och färger" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Ctrl+klick" /> på en jingle lägger till eller tar bort den från deck-kön; siffersymbolen visar ordningen. I färgväljaren kan du använda HEX, visuellt färgfält, snabbval och namngivna sparade färgkombinationer.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Saknad fil" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">En knapp märkt SAKNAS har kvar alla inställningar men ljudfilens sökväg fungerar inte. Använd <Run FontWeight="Bold">Verktyg → Kontrollera ljudfiler</Run> för att söka efter och länka om flyttade filer.</TextBlock>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- 04 Autoplay -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="AutoplayPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="AUTOPLAY OCH KÖER" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Musiklistor som spelar vidare" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Bygg kön" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna Autoplay-fliken. Välj Alla eller filtrera på ett deck, sök efter titel och dubbelklicka eller använd vänsterpilen för att lägga till. Högerpilen vid deckfiltren flyttar till nästa flik när alla inte ryms. Alla kan även visa råa filer från vald musikmapp; deckfilter använder jinglarna med deras sparade start/slut och egenskaper.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Ordning och uppspelning" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}">Dra rader i kön eller använd upp/ned. Spela nu startar vald rad. Delete eller Ta bort tar bort den valda raden från kön, inte från disken. När en låt tar slut går Autoplay vidare. Loop börjar om från rad 1; Shuffle väljer nästa slumpmässigt.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,8,0,0">Under Verktyg &gt; Inställningar &gt; Autoplay kan du skapa flera namngivna Autoplay-listor. Varje post har egen sparad spellista, snabbtangent och fast volymändring. Tangenten öppnar Autoplay, laddar rätt lista och startar första låten automatiskt. Ett negativt värde som −8 dB passar när periodpausens musik ska ligga tydligt lägre.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Övergång" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Övergångstiden delas så att ungefär 75 % används för uttoning och 25 % för intoning. Börja runt 4 sekunder och anpassa efter materialet. Auto gain för varje analyserad låt är fast under hela övergången.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Space och vyisolering" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Autoplay-kön används endast när Autoplay-vyn är aktiv. Space tonar ut aktuell låt och nästa Space återupptar den inom två minuter. Naturligt låtslut går vidare i kön. När du går tillbaka till ett deck ignoreras Autoplay-kön.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Spellistor och förlyssning" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Spara/ladda köer som spellistor. Spellistan kommer ihåg både <Run FontWeight="Bold">Shuffle</Run> och <Run FontWeight="Bold">Loop</Run> och återställer dem vid manuell laddning eller snabbstart. Äldre spellistor utan dessa uppgifter öppnas med Shuffle av och Loop på. Välj musikmapp för råa filer. När Förlyssning och Utgångsenhet 2 är aktiverade kan du <Run FontWeight="Bold">Shift+klicka</Run> en låt för att lyssna i hörlurar utan att byta publikens huvudutgång.</TextBlock>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- 05 Slumpgrupper -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="RandomPoolsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="SLUMPGRUPPER" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Situationsstyrd musik med en enda tangent" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="När slumpgrupper passar" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Använd <Run FontWeight="Bold">Verktyg → Slumpmässig låtspelare</Run> när samma matchsituation kan använda flera olika ljud, exempelvis Utvisning hemma, Utvisning borta, Mål eller Publik. Varje grupp får en egen snabbtangent och väljer bara bland ljuden du lagt i gruppens pool.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Skapa profil och grupp" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">En slumpprofil är en komplett uppsättning grupper. Skapa separata profiler när flera lag delar samma musikprofil men behöver olika pooler och tangenter. Välj aktiv slumpprofil högst upp, skapa en grupp, ge den ett tydligt situationsnamn och välj en unik snabbtangent.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Poolöversikt och deckvariation" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Poolöversikten visar hur många ljud och hur stor procentandel som kommer från varje deltagande deck. Aktivera <Run FontWeight="Bold">Deckvariation</Run> om ett stort deck inte ska dominera. När det valda maxantalet från samma deck har spelats i följd väljs nästa ljud från ett annat deltagande deck om det finns något spelbart. Ospelade ljud prioriteras, men ett tidigare spelat ljud från ett annat deck kan användas som säkerhetsventil. Inställningen sparas separat för varje slumpgrupp.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Välj och sortera ljud" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Sökfältet söker i alla deck och öppnar automatiskt decket med bästa träffen. Välj hela decket eller markera enskilda ljud. Knapparna <Run FontWeight="Bold">Deck</Run>, <Run FontWeight="Bold">A–Ö</Run> och <Run FontWeight="Bold">Ö–A</Run> ändrar bara visningsordningen och gör det enklare att kontrollera poolen; de ändrar inte deckets verkliga ordning.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Automatisk följdlåt" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Välj en eller flera följdlåtar om den slumpade låten automatiskt ska lämna över när den spelat färdigt naturligt. Med flera val väljs en av dem slumpmässigt. Manuell Fade, Stopp eller ett andra tryck på gruppens tangent startar aldrig följdlåten.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Använd tangenten under match" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Första trycket – " />spelar ett slumpvalt ljud. Med Session aktiv prioriteras ljud som inte redan har spelats.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,5,0,0"><Run FontWeight="Bold" Text="Andra trycket – " />tonar ut det aktiva slumpvalet utan att starta en följdlåt.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,5,0,0"><Run FontWeight="Bold" Text="Tredje trycket – " />väljer ett nytt ljud och undviker föregående val när fler alternativ finns.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Spara och flytta" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Slumpprofiler, grupper, pooler, snabbtangenter och följdlåtar sparas i musikprofilen. Komplett flyttbackup tar även med de refererade ljudfilerna till en annan dator.</TextBlock>
                        </GroupBox>
                        <Border Background="#1836E0B4" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
                            <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Bra namngivning: " />skriv situation och lag, exempelvis ”Utvisning borta – IBF”, så blir rätt grupp enkel att hitta och testa.</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 06 Ljud -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="AudioPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="LJUD OCH BALANSERING" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Jämn nivå utan att ändra filerna" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Begreppen" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="LUFS – " />upplevd genomsnittlig ljudstyrka. −16 LUFS är starkare än −20 men svagare än −10.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,4,0,0"><Run FontWeight="Bold" Text="True peak/dBTP – " />högsta beräknade verkliga topp. Ett negativt tak lämnar säkerhetsmarginal till digital maxnivå.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,4,0,0"><Run FontWeight="Bold" Text="Auto gain – " />fast uppspelningsjustering som försöker nå målnivån utan att överskrida peak-taket.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Rekommenderad start för idrottshall" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Använd cirka <Run FontWeight="Bold">−16 LUFS</Run>, limiter aktiverad och <Run FontWeight="Bold">−1 eller −2 dBTP</Run>. −2 ger extra marginal för ojämna PA-system. Den verkliga nivån i publiken måste fortfarande ställas med mixer/PA och helst kontrolleras med SPL-mätare.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Analysera eller balansera" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Analysera" /> sparar mätvärden men ändrar inte uppspelningen. <Run FontWeight="Bold" Text="Analysera och balansera" /> aktiverar Auto gain. Använd urvalet för att visa endast ljud som ännu inte analyserats eller endast ljud som inte både analyserats och balanserats. Sökfältet filtrerar på titel, filnamn och deck; markeringarna avgör vilka träffar som bearbetas. Plus höjer, minus sänker. Om peak-taket nås får en tyst fil inte höjas hela vägen till målnivån.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Manuell finjustering och säkerhet" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Manuell gain läggs ovanpå Auto gain och är avsedd för öronmässig finjustering. Säkerhetslimitern fångar toppar. Automatiskt mixutrymme används vid avsiktligt samtidiga ljud, men en vanlig uttonande låt ändrar inte nästa låts gain.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Jinglebyggaren" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Välj <Run FontWeight="Bold">06 Jinglebyggaren</Run> i menyn till vänster för en steg-för-steg-guide till mållåtar, övergångar, parallella ljudeffekter och export.</TextBlock>
                        </GroupBox>
                        <Border Background="#18FFC15A" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
                            <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Observera: " />analysrutorna visar källans analys före manuell gain, EQ och kompressor. Ändrar du dessa påverkas den verkliga utgången; analysera om efter större ljudändringar.</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 06 Jinglebyggaren -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="JingleBuilderPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="JINGLEBYGGAREN" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Skapa mållåtar och egna ljudsekvenser" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Öppna och välj ljud" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna <Run FontWeight="Bold">Verktyg → Bygg egen jingle</Run>. De första ljuden kan hämtas från profilens decks. Välj <Run FontWeight="Bold">Öppna rå ljudfil</Run> om materialet inte redan finns som jingle. <Run FontWeight="Bold">Lägg till ljud</Run> skapar fler delar och flikarna högst upp växlar mellan dem. Pilarna ändrar ordningen.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Arbeta med markören" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Klicka i vågformen för att hoppa eller håll vänster musknapp och dra åt vänster/höger. Håll <Run FontWeight="Bold">Ctrl</Run> medan du drar för finare rörelse. Play-knappen spelar valt ljud från markören; Paus och Stopp påverkar bara förhandslyssningen i byggaren.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Start, slut och nästa ljud" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Start/Slut – " />trimma vilken del av det valda ljudet som ska användas. Flytta markören och tryck på målsymbolen. Markera Använd slut när en särskild slutpunkt behövs.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,5,0,0"><Run FontWeight="Bold" Text="Start för nästa ljud – " />den orange linjen. Den bestämmer när ljud 2, 3 och följande delar börjar i förhållande till föregående ljud.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,5,0,0">Tider kan också skrivas manuellt. Tryck Enter för att använda värdet.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Mixhjälp: BPM, tonart och energi" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Välj två ljud och tryck på <Run FontWeight="Bold">Analysera ljudparet</Run>. Analysen körs lokalt på datorn och visar tempo (BPM), musikalisk tonart med Camelot-kod och energinivå. Matchpoängen väger samman rytm, harmonik och energi. <Run FontWeight="Bold">Använd övergångsförslag</Run> placerar en taktnära crossfade och fyller i en föreslagen längd. Resultatet är ett hjälpmedel – förhandslyssna alltid, särskilt med tal, sirener och korta effekter. Analysen sparas i profilen och räknas om när filen eller klippgränserna ändras; originalfilen påverkas aldrig.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Lång mix och analys av flera låtar" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Välj <Run FontWeight="Bold">Lång mix</Run> högst upp för uppvärmningsmixar och längre musikpass. Filtrera på ett deck eller sök i hela profilen, markera minst två låtar och välj <Run FontWeight="Bold">Analysera valda</Run>. Ange önskad total mixlängd samt minsta och längsta tid per låt. <Run FontWeight="Bold">Föreslå spelordning</Run> provar möjliga startlåtar, bygger en följd med jämna BPM-, Camelot- och energiövergångar och flyttar varje byte till närmaste musikaliska 16-taktsfras. Öppna därefter ordningen i långmixredigeraren för att lyssna, flytta markörer och finjustera varje crossfade.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Tre typer av övergång" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Crossfade – " />vid den orange linjen tonas föregående ljud ut samtidigt som nästa tonas in. Bra för en mjuk musikalisk övergång.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,5,0,0"><Run FontWeight="Bold" Text="Fade out → fade in – " />första ljudet tonas ut helt innan nästa ljud startar. Delarna överlappar inte.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,5,0,0"><Run FontWeight="Bold" Text="Mixljud – " />nästa ljud läggs ovanpå det föregående, som fortsätter på oförändrad nivå. Använd för exempelvis siren, goal horn eller publikljud ovanpå en mållåt. Endast det nya lagret tonas in.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Flera samtidiga lager" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">För en mållåt med flera effekter: använd huvudlåten som ljud 1 eller 2 och välj <Run FontWeight="Bold">Mixljud</Run> för siren, klapp eller andra lager. Markera <Run FontWeight="Bold">Starta nästa ljud samtidigt</Run> när lagren ska börja på samma tidsposition. Varje ljudflik har egen nivå i dB så att effekterna inte överröstar huvudlåten.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Mallar och förhandslyssning" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Mallarna Mållåt, Utvisning och Mjuk musikövergång fyller i lämpliga startvärden för övergångarna. Välj Egen för full kontroll. Använd <Run FontWeight="Bold">Förhandslyssna hela mixen</Run> för att höra samtliga delar i rätt ordning innan filen skapas.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Skapa och lägg till" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">När du väljer <Run FontWeight="Bold">Skapa och lägg till</Run> föreslår FloorballDJ mappen <Run FontWeight="Bold">Skapade jinglar</Run>. Ange filnamn och spara. Resultatet är en ny okomprimerad PCM-WAV som läggs till i profilen; källfilerna ändras aldrig.</TextBlock>
                        </GroupBox>
                        <Border Background="#18FFC15A" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
                            <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Nivåtips: " />flera samtidiga ljud summeras. Börja med att sänka effektlagren några dB och kontrollera hela mixen i förhandslyssningen innan den används i hallen.</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 07 Egenskaper -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="PropertiesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="JINGLE-EGENSKAPER" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Klipp, förhandslyssna och forma ljudet" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Waveforms och position" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Klicka i Full waveform för att hoppa. Den inzoomade tiasekundersvyn följer markören; håll vänster musknapp och dra för precision. Play/Paus/Stopp styr endast förhandslyssningen i egenskapsfönstret.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Start och slut" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Flytta markören och välj Start eller Stopp. Du kan skriva sekunder (78) eller tid (01:18). Plus/minus flyttar 0,1 sekund; håll Shift för 0,01 sekund. Trimma tystnad föreslår hörbara gränser automatiskt.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Uppspelning och snabbtangent" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Välj Solo/Mix/Duck, Loop, egna fade-tider och Välj snabbknapp. Kryssknappen bredvid tar bort en befintlig snabb- eller slumpknapp. Markera Hoppa till om snabbknappen också ska visa jingelns deck. Modifierare som Ctrl, Shift, Alt och Win väntar på ytterligare en tangent. Space är reserverad för uppspelningsflödet.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Ljudmixer" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Normalisering ger jämn grundnivå och manuell gain finjusterar. Bas/Mellan/Diskant formar tonen. Kompressorn dämpar signal över tröskeln; högre ratio ger kraftigare kontroll, Attack bestämmer hur snabbt den reagerar och Release hur snabbt den släpper.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Pitch, tempo och rate" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Pitch ändrar tonhöjd. Tempo/Rate-reglagen visas i betaversionen men är ännu inte fullt inkopplade i huvuduppspelningen. Förlita dig därför inte på dem i en skarp match innan funktionen färdigställts.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Teknisk information" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Fliken visar bland annat format, samplingsfrekvens, kanaler, bitrate och filstorlek. Informationen är främst till för kontroll och felsökning.</TextBlock>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- 08 Team Deck -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="TeamDeckPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="TEAM DECK" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Standardjingle först – spelarövergång sedan" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Vad Team Deck gör" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Team Deck är en profilbunden snabbvy för ett lag. En gemensam snabbtangent startar lagets standardjingle, vanligtvis en goal horn eller mållåt, och öppnar därefter en stream deck-liknande vy med en knapp för varje spelare. Standardjingeln startar alltid direkt med 0 sekunders hörbar fade in.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Skapa ett lag" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna <Run FontWeight="Bold">Verktyg → Team Deck</Run> och välj Nytt lag. Ange lagnamn, välj snabbtangent och välj standardjingle bland profilens befintliga ljud. Du kan skapa flera Team Deck i samma profil, exempelvis hemmalag och bortalag, men varje lag behöver en unik snabbtangent.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Lägg till spelare" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Välj Lägg till spelare och fyll i nummer och namn. Knappen Sök öppnar en sökbar lista där du kan hitta ljud efter titel, filnamn eller deck. Startposition anger var i spelarens ljudfil uppspelningen ska börja; värdet är unikt för Team Deck och ändrar inte originaljingeln. En spelare utan vald jingle visas men spelar inget ljud.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Övergångspunkt och fades" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Övergångspunkten räknas från standardjingelns klippta start och anger när den valda spelarjingeln ska börja. Auto startar övergången nära standardjingelns slut. Fade out lagjingle styr hur snabbt standardljudet tonas bort och Fade in spelare hur snabbt spelarens ljud når full nivå. En bra start för sporthall är 1,5 sekunder fade out och 0,75 sekunder fade in.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Använd under match" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Tryck lagets snabbtangent. Standardjingeln startar direkt och spelarvyn öppnas. Klicka på målskyttens knapp medan standardjingeln spelar; en turkos ram visar vem som väntar. Du kan byta spelare genom att klicka på en annan knapp eller avmarkera genom att klicka på samma igen. Vid övergångspunkten crossfadas den valda spelarjingeln automatiskt in från spelarens sparade startposition. Dra en spelarbricka till en annan plats i rutnätet för att spara en ny ordning.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Förhandsvisa och spara" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Förhandsvisa visar hur spelarknapparna kommer att se ut och låter dig testa kopplingarna. Spara Team Deck skriver inställningarna till den öppna profilen. Team Deck, spelarnamn, snabbtangent och alla jinglekopplingar följer med profilen och en komplett flyttbackup.</TextBlock>
                        </GroupBox>
                        <Border Background="#1836E0B4" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
                            <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Förbered före match: " />testa standardjingeln • kontrollera varje spelares ljud • säkerställ att inga snabbtangenter ersatts • skapa flyttbackup.</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 09 Profiler -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="ProfilesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="PROFILER OCH BACKUP" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Spara, flytta och återställ arbetet" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Profilmenyn" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Nytt projekt skapar en tom profil. Öppna eller Importera profil laddar en .floorballdj.json-profil. Importera profil kan också konvertera Snap Jingle Player XML och anpassar då decks/layout efter innehållet. Dialogen Spara profil föreslår programmets mapp <Run FontWeight="Bold">Profiler</Run>; byggaren föreslår <Run FontWeight="Bold">Skapade jinglar</Run>. Under Senast använda profiler visas de fem senaste giltiga profilerna; en stjärna markerar standardprofilen. För flera identiska varianter öppnar du grundprofilen och använder Spara som med ett nytt namn för varje kopia.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Standardprofil" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Välj en standardprofil under <Run FontWeight="Bold">Verktyg → Inställningar → Profiler</Run> om samma matchprofil alltid ska öppnas vid start. Dropdownen visar upp till fem senast använda, namngivna profilfiler. Den vanliga interna autosparningen visas inte som en separat profil. Välj Ingen standard för att återgå till autosparningen.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Autosparning och historik" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Ändringar autosparas. Under <Run FontWeight="Bold">Hjälp → Autosparningshistorik</Run> kan du granska och återställa tidigare versioner. Upp till 100 ändrade revisioner sparas per profil. Återställning ersätter den aktuella profilen, så kontrollera datum och innehåll.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Backup och flytt till en annan dator" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontWeight="Bold" Text="Spara som – " />skapar endast en profilfil. Den innehåller deck, knappar, fades, färger, snabbtangenter, slumpgrupper och ljudinställningar, men kopierar inte ljudfilerna.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,5,0,0"><Run FontWeight="Bold" Text="Komplett flyttbackup – " />finns både under Profil och Kontrollera ljudfiler. Båda knapparna kör exakt samma backupprocess. Den skapar en flyttbar mapp med profil, oförändrade originalkopior av alla refererade ljudfiler, egna typsnitt, sparade färgval och en backupbeskrivning. Ingen omkodning, komprimering eller kvalitetsförlust sker.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Flytta till en annan dator" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}">Kopiera hela backupmappen till den nya datorn och välj <Run FontWeight="Bold">Profil → Återställ flyttbackup</Run>. FloorballDJ kopierar innehållet till en stabil lokal plats, importerar typsnitt och färgval, öppnar profilen och gör den till standard. Välj därefter ljudutgångar för den nya datorn.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}" Margin="0,5,0,0"><Run FontWeight="Bold" Text="Överförs inte: " />licens/provperiod, Windows-specifika ljudenhets-ID:n och extern musik som inte används av någon jingle. Licensen är maskinbunden och aktiveras separat. Saknade filer redovisas tydligt när backupen skapas.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Ljudfiler och egna typsnitt" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Kontrollera ljudfiler visar hittade/saknade filer, söker rekursivt och uppdaterar sökvägar. Egna .ttf/.otf läggs i Fonts-mappen som öppnas från Inställningar; välj Uppdatera efter att filer lagts till.</TextBlock>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- 10 Kortkommandon -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="ShortcutsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="KORTKOMMANDON" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Snabb kontroll utan att leta" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Globalt" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Space          " />tona ut/återuppta; med deck-kö startar nästa Space nästa köade ljud.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Ctrl+S         " />spara profilen.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="F1             " />öppna hjälpcentret.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Egen tangent   " />spela jingeln som fått snabbtangenten i Egenskaper.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Esc            " />stäng/avbryt de flesta dialogrutor.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Mus och modifierare" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Ctrl+klick     " />lägg till/ta bort deck-jingle i kön.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Shift+klick    " />förlyssna en låt i Autoplay när Utgångsenhet 2 är aktiv.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Scroll flikar  " />byt deck.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Scroll volym   " />ändra mastergain när pekaren är över volymreglaget.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Klick waveform " />hoppa till vald position.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Autoplay och redigering" Style="{StaticResource HelpGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Delete         " />ta bort vald rad ur Autoplay-kön.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Enter          " />bekräfta tids- och många värdefält.</TextBlock>
                                <TextBlock Style="{StaticResource HelpBody}"><Run FontFamily="Cascadia Mono" FontWeight="Bold" Text="Shift +/−      " />justera start/slut med 0,01 s; utan Shift är steget 0,1 s.</TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <Border Background="#1836E0B4" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
                            <TextBlock Style="{StaticResource HelpBody}">Egna snabbtangenter kan innehålla Ctrl, Shift, Alt eller Win tillsammans med en annan tangent. Vald deck söks först; därefter övriga decks. Tangenter triggas inte när du skriver i ett textfält.</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 11 Licens -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="LicensingPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="LICENS OCH PROVPERIOD" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Aktivering och offlineanvändning" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Fjorton dagars provperiod" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Första starten kräver internet. Provperioden kopplas till datorn och börjar när licenstjänsten godkänner första starten. Återstående dagar visas i statusraden längst ned. Om perioden tar slut medan FloorballDJ är öppet visas en varning och en 24-timmars nedräkning. Därefter sparas profilen och programmet stängs automatiskt.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Aktivera en köpt licens" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna <Run FontWeight="Bold">Hjälp → Licens och provperiod</Run>, ange licensnyckeln och välj Aktivera licens. Nyckeln skickas via en krypterad anslutning och sparas inte i klartext på datorn.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Användning utan internet" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Efter aktivering sparas ett signerat och Windows-krypterat licensbevis. En köpt licens fungerar normalt offline i upp till 30 dagar innan en kort onlinekontroll behövs. En pågående match eller ljuduppspelning avbryts aldrig av en licenskontroll.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Ny dator eller avaktivering" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">En ny dator måste aktiveras online. Avaktivera den gamla datorn under licensfönstret för att frigöra platsen. Avaktivering kräver internet och stänger programmet när den är klar.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Sök efter uppdateringar" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna <Run FontWeight="Bold">Hjälp → Sök efter uppdateringar</Run>. Kontrollen körs endast när du väljer kommandot. En ny installerare hämtas via GitHub Releases och måste matcha den publicerade SHA-256-kontrollsumman. Installationen startar inte medan ljud spelas och profilen sparas innan FloorballDJ stängs.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Om kontrollen misslyckas" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Kontrollera internet, datorns datum och tid samt att en brandvägg inte blockerar floorballdj-licensing-api.netlify.app. En giltig, ännu inte utgången offlineaktivering fortsätter fungera även när licenstjänsten tillfälligt inte kan nås.</TextBlock>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- 12 Felsökning -->
                <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" x:Name="TroubleshootingPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="FELSÖKNING" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Vanliga problem och säkra kontroller" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,3,0,14" />
                        <GroupBox Header="Inget ljud" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Kontrollera vald utgång, Windows-volym, programvolym och att Förlyssning inte är aktiv. Testa Windows standardenhet. Om Utgångsenhet 2 kopplas bort, stäng Förlyssning och välj en aktiv enhet igen.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Saknade eller flyttade filer" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Öppna Kontrollera ljudfiler, välj musikbibliotekets rotmapp och kör Sök och uppdatera. Sökningen matchar filnamn i undermappar. Kontrollera listans problemtext om en fil inte hittas.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Ojämn volym" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Analysera hela biblioteket med samma mål och peak-tak. Kontrollera att Normalisering är aktiverad. Manuell gain, EQ och kompressor kan förändra slutresultatet. L/R-mätaren visar toppar och behöver inte se identisk ut för låtar som upplevs lika starka.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Hack eller nivåhopp" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Använd senaste versionen, välj en stabil aktiv ljudenhet och undvik Bluetooth för publikljud om möjligt. Kontrollera egna fades och extrema EQ/kompressorinställningar. Notera vilka två filer och spellägen som används om problemet går att upprepa.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Analysvärdet verkar gammalt" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Analysen blir inaktuell om filen eller klippets start/slut ändras. Analysera om. EQ, kompressor och manuell gain påverkar den verkliga utgången även om källanalysens LUFS/true peak ligger kvar i informationsrutorna.</TextBlock>
                        </GroupBox>
                        <GroupBox Header="Krasch eller återställning" Style="{StaticResource HelpGroup}">
                            <TextBlock Style="{StaticResource HelpBody}">Starta om programmet och kontrollera autosparningshistoriken. Kraschloggar sparas i FloorballDJ:s Logs-mapp under lokal appdata. Behåll loggen, profilfilen och en kort beskrivning av senaste åtgärden när felet rapporteras.</TextBlock>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <TextBlock Text="Ny användare? Börja under Grundläggande. Slumpgrupper, Team Deck och ljudverktyg finns under Avancerat." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button Content="Stäng" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="110" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
