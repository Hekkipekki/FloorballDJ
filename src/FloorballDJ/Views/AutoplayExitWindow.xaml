<Window x:Class="FloorballDJ.Views.AutoplayExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lämna Autoplay" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="26">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Lämna Autoplay?" Style="{StaticResource SectionTitle}" FontSize="25" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="De köade låtarna fortsätter inte automatiskt när du lämnar Autoplay. Kön behålls."
                       Margin="0,12,0,24" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                <Button x:Name="StayButton" Content="Stanna i Autoplay" IsCancel="True" IsDefault="True" Click="Stay_Click"
                        Style="{StaticResource SecondaryButton}" Margin="0,4,8,0"/>
                <Button x:Name="LeaveButton" Content="Lämna Autoplay" Click="Leave_Click"
                        Style="{StaticResource PrimaryButton}" Margin="0,4,0,0"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
