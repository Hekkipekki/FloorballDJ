# FloorballDJ Community – servervariabler i Netlify. Lägg aldrig riktiga värden i Git.
# Trådar, svar, rapporter och hastighetsbegränsning lagras i Netlify Blobs.
COMMUNITY_ADMIN_API_KEY=replace-with-a-long-random-value
COMMUNITY_IP_PEPPER=replace-with-a-different-long-random-value
COMMUNITY_EDIT_TOKEN_PEPPER=replace-with-a-third-long-random-value
COMMUNITY_POSTING_ENABLED=true

# Rekommenderas innan COMMUNITY_POSTING_ENABLED sätts till true.
COMMUNITY_TURNSTILE_SECRET_KEY=
